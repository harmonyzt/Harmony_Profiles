<Project>
  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">D:\401SPT</GameRoot>
    <ServerPath Condition="'$(ServerPath)' == ''">$(GameRoot)\SPT_Runtime</ServerPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/PBT/</PathMap>
    <Version>2.0.0</Version>
  </PropertyGroup>
</Project>
