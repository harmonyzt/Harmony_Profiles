        }
        else if (page == "Messages")
        {
            <section class="fb-card"><h2>Bot messages</h2><p class="fb-muted">Players you kill, or that kill you, can message you after the raid. They only speak up after something notable: a squad wipe, a long shot, a kill at an exit or on a full bag, a boss raid, a rampage cut short, an underdog win or an expensive kit. Their tone follows the personality, and streamers talk to their chat.</p>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.BotMessages.Enabled" /><span class="fb-switch-track"></span>Send player messages@(Tip("Let bots message you after notable raid events."))</label></div>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.BotMessages.ReplaceNativeMessages" /><span class="fb-switch-track"></span>Silence SPT's own PMC messages@(Tip("Players never send SPT's built-in victim and killer messages."))</label></div>
                <div class="fb-grid fb-grid-3">
                    <label class="fb-field"><span class="fb-label">Chance per notable event@(Tip("Chance (0 to 1) that a notable event gets a message. A squad wipe counts three times. At most one message per raid."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.BotMessages.Chance" /></label>
                    <label class="fb-field"><span class="fb-label">Delay, minimum seconds@(Tip("Earliest time after the raid that a message arrives."))</span><input type="number" min="0" max="3600" @bind="simulation.BotMessages.MinimumDelaySeconds" /></label>
                    <label class="fb-field"><span class="fb-label">Delay, maximum seconds@(Tip("Latest time after the raid that a message arrives."))</span><input type="number" min="0" max="3600" @bind="simulation.BotMessages.MaximumDelaySeconds" /></label>
                </div>
            </section>
            @SimulationSave
