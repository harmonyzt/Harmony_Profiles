@page "/pbt"
@namespace PBT.Server.Web
@using PBT.Server
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@layout SPTarkov.Server.Web.Layout.BaseMainLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@rendermode InteractiveServer
@implements IDisposable

@{ dirtyCache.Clear(); }
<PageTitle>PBT - Progressive Bot Profiles</PageTitle>
<HeadContent>
    <link rel="icon" type="image/png" href="/pbt-assets/icon-128.png"/>
</HeadContent>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link href="/pbt-assets/pbt.css?v=20261108-peak-hero" rel="stylesheet"/>
<div class="pbt-editor" data-theme="@(dark ? "dark" : "light")">
<nav class="fb-topbar">
    <button
        type="button"
        class="fb-icon-button fb-menu"
        aria-label="Toggle navigation"
        aria-expanded="@(menuOpen ? "true" : "false")"
        @onclick="() => menuOpen = !menuOpen">
        <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h14"/>
        </svg>
    </button>
    <span class="fb-brand">
        <img class="fb-logo" src="/pbt-assets/icon-128.png" alt=""/><span>PBT</span><small>Progressive Bot Profiles</small>
    </span>
    <span class="fb-spacer"></span>
    @if (presets.FirstOrDefault(p => p.Selected) is { } chosen)
    {
        <button
            type="button"
            class="fb-pill fb-pill-button"
            title="Manage presets"
            @onclick='() => Go("Presets")'>Preset: @chosen.Name@(chosen.Modified ? " (changed)" : "")</button>
    }
    @if (snapshot is null)
    {
        <span class="fb-pill fb-pill-red"><span class="fb-pill-dot" aria-hidden="true"></span>Settings unavailable</span>
    }
    <button
        type="button"
        class="fb-icon-button"
        title="@(dark ? "Switch to light mode" : "Switch to dark mode")"
        aria-label="Toggle dark mode"
        @onclick="() => dark = !dark">
        @if (dark)
        {
            <svg viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="3.5"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"/>
            </svg>
        }
        else
        {
            <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M16 12.5A7 7 0 0 1 7.5 4a7 7 0 1 0 8.5 8.5Z"/>
            </svg>
        }
    </button>
</nav>

<aside class="fb-sidebar @(menuOpen ? "fb-open" : "")" aria-label="PBT sections">
    <ul class="fb-nav">
        @foreach (var item in topPages)
        {
            @if (item == "Simulation")
            {
                <li>
                    <button
                        type="button"
                        class="fb-nav-item @(simulationPages.Contains(page) ? "fb-parent-active" : "")"
                        aria-expanded="@(simulationOpen ? "true" : "false")"
                        @onclick="() => simulationOpen = !simulationOpen">
                        @Icon("Simulation")<span class="fb-nav-label">Simulation</span>
                        @if (Dirty("simulation"))
                        {
                            <span class="fb-dot" aria-hidden="true"></span>
                            <span class="fb-sr-only">, unsaved changes</span>
                        }
                        <svg class="fb-chevron @(simulationOpen ? "fb-rotated" : "")" viewBox="0 0 20 20" aria-hidden="true">
                            <path d="m6 8 4 4 4-4"/>
                        </svg>
                    </button>
                    @if (simulationOpen)
                    {
                        <ul class="fb-subnav">
                            @foreach (var sub in simulationPages)
                            {
                                <li>
                                    <button
                                        type="button"
                                        class="fb-nav-item @(page == sub ? "fb-active" : "")"
                                        aria-current="@(page == sub ? "page" : null)"
                                        @onclick="() => Go(sub)">@SubIcon(sub)@Title(sub)</button>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
            else
            {
                <li>
                    <button
                        type="button"
                        class="fb-nav-item @(page == item ? "fb-active" : "")"
                        aria-current="@(page == item ? "page" : null)"
                        @onclick="() => Go(item)">
                        @Icon(item)<span class="fb-nav-label">@Title(item)</span>
                        @if (PageDirty(item))
                        {
                            <span class="fb-dot" aria-hidden="true"></span>
                            <span class="fb-sr-only">, unsaved changes</span>
                        }
                    </button>
                </li>
            }
        }
    </ul>
    <ul class="fb-nav fb-nav-secondary">
        <li>
            <a class="fb-nav-item" href="https://github.com/harmonyzt/Harmony_Profiles" target="_blank" rel="noopener">
                @Icon("GitHub")<span class="fb-nav-label">GitHub repository</span>
            </a>
        </li>
        <li>
            <button type="button" class="fb-nav-item" @onclick="RequestReload">
                @Icon("Reload")<span class="fb-nav-label">Reload saved settings</span>
            </button>
        </li>
    </ul>
</aside>
@if (menuOpen)
{
    <div class="fb-backdrop" @onclick="() => menuOpen = false"></div>
}

<main class="fb-content" @key="page">
<ol class="fb-breadcrumb" aria-label="Breadcrumb">
    <li>@Icon("Home")PBT</li>
    @if (simulationPages.Contains(page))
    {
        <li>Simulation</li>
    }
    <li aria-current="page">@Title(page)</li>
</ol>
<div class="fb-page-heading">
    <div>
        <h1>@Heading(page)</h1>
        <p>@Description(page)</p>
    </div>
    @if (page == "Dashboard" && snapshot is not null)
    {
        <button type="button" class="fb-button fb-button-light" @onclick="RefreshStatus">@Icon("Reload") Refresh status</button>
    }
    else if (Section(page) is { } section)
    {
        <span class="fb-badge @(Dirty(section) ? "fb-badge-yellow" : "fb-badge-green")">@(Dirty(section) ? "Unsaved changes" : "Saved")</span>
    }
</div>

@if (confirmReload)
{
    <div class="fb-alert fb-alert-yellow" role="alertdialog" aria-label="Discard unsaved settings">
        <div><strong>Discard unsaved changes?</strong> Every section with edits goes back to the saved settings.</div>
        <div class="fb-actions">
            <button
                type="button"
                class="fb-button fb-button-red"
                @onclick="Reload">Discard and reload</button><button type="button" class="fb-button fb-button-light" @onclick="() => confirmReload = false">Keep editing</button>
        </div>
    </div>
}
@if (!string.IsNullOrEmpty(message))
{
    <div role="status" aria-live="polite" class="fb-alert @(error ? "fb-alert-red" : "fb-alert-green")">@message</div>
}

@if (snapshot is null)
{
    <section class="fb-card fb-empty">
        <h2>Settings are unavailable</h2>
        <p>The population store could not be loaded. Try again when the server is ready.</p><button type="button" class="fb-button" @onclick="Reload">Try again</button>
    </section>
}
else if (page == "Overview")
{
    var maps = world?.Maps ?? [];
    <section class="fb-hero" aria-label="Maps" @onmouseenter="() => slideHover = true" @onmouseleave="() => slideHover = false">
        <div class="fb-hero-track" style="transform:translateX(-@(slide * 100)%)">
            @foreach (var map in maps)
            {
                <article
                    class="fb-slide"
                    @key="map.Id"
                    style="--fb-map-hue:@Hue(map.Id);background-image:url('/pbt-assets/maps/@(map.Id).jpg'),linear-gradient(135deg,hsl(@Hue(map.Id) 35% 28%),hsl(@((Hue(map.Id) + 40) % 360) 30% 12%))">
                    <div class="fb-slide-shade"></div>
                    <div class="fb-slide-body">
                        @if (map.WeeklyBoss)
                        {
                            <span class="fb-badge fb-badge-yellow">Weekly boss</span>
                        }
                        @if (map.Solo)
                        {
                            <span class="fb-badge fb-badge-green">Solo instance</span>
                        }
                        <h2 class="fb-slide-name">@map.Name</h2>
                        <ul class="fb-slide-stats">
                            <li>
                                <strong>@Num("slide-raid-" + map.Id, map.InRaid)</strong><span>in raid</span>
                            </li>
                            <li>
                                <strong>@Num("slide-queue-" + map.Id, map.Queueing)</strong><span>queueing</span>
                            </li>
                            <li>
                                <strong>@Clock(map.QueueSeconds)</strong><span>avg queue</span>
                            </li>
                            <li>
                                <strong>@((map.Share * 100).ToString("0"))%</strong><span>of players</span>
                            </li>
                        </ul>
                    </div>
                </article>
            }
        </div>
        @if (maps.Count > 1)
        {
            <button
                type="button"
                class="fb-hero-arrow fb-hero-prev"
                aria-label="Previous map"
                title="Previous map"
                @onclick="() => SlideBy(-1)">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m12 5-5 5 5 5"/>
                </svg>
            </button>
            <button
                type="button"
                class="fb-hero-arrow fb-hero-next"
                aria-label="Next map"
                title="Next map"
                @onclick="() => SlideBy(1)">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m8 5 5 5-5 5"/>
                </svg>
            </button>
            <div class="fb-hero-dots">
                @for (int index = 0; index < maps.Count; index++)
                {
                    int target = index;
                    <button
                        type="button"
                        class="@(index == slide ? "fb-dot-active" : "")"
                        aria-label="Show @maps[index].Name"
                        @onclick="() => { slide = target; slideHeld = true; }"></button>
                }
            </div>
        }
    </section>

    <div class="fb-stats fb-stats-6">
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">Online@(Tip(
                "Accounts playing right now: in the menu, queueing, in a raid or in transit."))</span>
            <strong>@Num("online", world?.Online ?? 0)</strong>
        </article>
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">In raid@(Tip("Players in a raid, including the ones in yours."))</span>
            <strong>@Num("raid", world?.InRaid ?? 0)</strong>
        </article>
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">Queueing@(Tip("Players waiting for a match. Busy maps fill faster."))</span>
            <strong>@Num("queue", world?.Queueing ?? 0)</strong>
        </article>
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">Main menu@(Tip("Online between raids: sorting the stash, regearing, flea."))</span>
            <strong>@Num("menu", world?.InMenu ?? 0)</strong>
        </article>
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">In transit@(Tip("Survivors moving to a connected map with their gear."))</span>
            <strong>@Num("transit", world?.InTransit ?? 0)</strong>
        </article>
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">Pending stories@(Tip("PMCs from your raids whose outcome is still to come."))</span>
            <strong>@Num("stories", world?.PendingStories ?? 0)</strong>
        </article>
    </div>

    <div class="fb-row fb-row-wide">
        <section class="fb-card fb-flush">
            <div class="fb-card-head fb-padded">
                <div>
                    <h2>Maps</h2>
                    <p>Players per map over the last 90 minutes.</p>
                </div>
            </div>
            <div class="fb-table-scroll">
                <table class="fb-table">
                    <thead>
                    <tr>
                        <th>Map</th><th>In raid</th><th>Queueing</th><th>Avg queue</th><th>Share</th><th>Last 90 min</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var map in maps)
                    {
                        <tr @key="map.Id">
                            <td>
                                <strong>@map.Name</strong>
                                @if (map.WeeklyBoss)
                                {
                                    <span class="fb-badge fb-badge-yellow fb-inline-badge">Weekly boss</span>
                                }
                                @if (map.Solo)
                                {
                                    <span
                                        class="fb-badge fb-badge-green fb-inline-badge"
                                        title="Private instance, no random PMCs">Solo</span>
                                }
                            </td>
                            <td>@Num("raid-" + map.Id, map.InRaid)</td>
                            <td>@Num("queue-" + map.Id, map.Queueing)</td>
                            <td>@Clock(map.QueueSeconds)</td>
                            <td>
                                <span class="fb-signal" title="@((map.Share * 100).ToString("0.0"))% of players">
                                    @for (int bar = 0; bar < 4; bar++)
                                    {
                                        <span class="@(bar < Bars(map.Share) ? "fb-lit" : "")"></span>
                                    }
                                </span>
                            </td>
                            <td>@Sparkline(map.History)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="fb-card">
            <div class="fb-card-head">
                <div>
                    <h2>Live activity</h2>
                    <p>What players are doing, newest first.</p>
                </div><span class="fb-live"><span></span>Live</span>
            </div>
            <ol class="fb-log">
                @foreach (var item in (world?.Events ?? []).Take(25))
                {
                    <li @key="item.Id" class="fb-log-@item.Kind">
                        <span class="fb-log-dot"></span><span class="fb-log-text">@item.Text</span><time>@Ago(item.Utc)</time>
                    </li>
                }
            </ol>
            @if (world?.Events.Count is null or 0)
            {
                <p class="fb-muted">Nothing yet. Players come online over the next few minutes.</p>
            }
        </section>
    </div>

    <section class="fb-card fb-flush">
        <div class="fb-card-head fb-padded">
            <div>
                <h2>Servers</h2>
                <p>Where players are queueing and playing. Ping is from your location (@(simulation?.World.Location ?? "EU")).</p>
            </div>
        </div>
        <div class="fb-table-scroll">
            <table class="fb-table">
                <thead>
                <tr>
                    <th>Server</th><th>Region</th><th>Status</th><th>Players</th><th>Load</th><th>Ping</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var server in world?.Servers ?? [])
                {
                    <tr @key="server.Name">
                        <td>
                            <strong>@server.Name</strong>
                        </td><td>@server.Region</td>
                        <td>
                            <span class="fb-badge @(server.Status switch { "Unstable" => "fb-badge-red", "Full" or "Busy" => "fb-badge-yellow", _ => "fb-badge-green" })">@server.Status</span>
                        </td>
                        <td>
                            @Num("server-" + server.Name, server.Players) <span class="fb-muted">/ @server.Capacity.ToString("N0")</span>
                        </td>
                        <td class="fb-server-load">
                            <span class="fb-progress" title="@((server.Load * 100).ToString("0"))% full">
                                <span style="width:@((server.Load * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            </span>
                        </td>
                        <td>~@server.Ping ms</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
else if (page == "Players")
{
    var rows = FilteredPlayers().ToList();
    int pages = Math.Max(1, (rows.Count + PageSize - 1) / PageSize);
    int current = Math.Clamp(playerPage, 0, pages - 1);
    <section class="fb-card">
        <div class="fb-toolbar fb-toolbar-wrap">
            <label class="fb-field">
                <span class="fb-label">Search</span>
                <input placeholder="Name" @bind="playerSearch" @bind:event="oninput" @bind:after="() => playerPage = 0"/>
            </label>
            <label class="fb-field">
                <span class="fb-label">Status</span>
                <select @bind="playerFilter" @bind:after="() => playerPage = 0">
                    @foreach (var (value, label) in statusFilters)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
            </label>
            <label class="fb-field">
                <span class="fb-label">Sort by</span>
                <select @bind="playerSort">
                    @foreach (var option in sortOptions)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>
            <button
                type="button"
                class="fb-button fb-button-light"
                @onclick="() => sortDescending = !sortDescending">@(sortDescending ? "Descending" : "Ascending")</button>
        </div>
    </section>
    <section class="fb-card fb-flush">
        <div class="fb-card-head fb-padded">
            <div>
                <h2>@rows.Count.ToString("N0") players</h2>
                <p>Updates every few seconds.</p>
            </div>
            <div class="fb-actions">
                <button
                    type="button"
                    class="fb-button fb-button-light"
                    disabled="@(current == 0)"
                    @onclick="() => playerPage = current - 1">Previous</button><span class="fb-muted fb-pager">@(current + 1) / @pages</span><button type="button" class="fb-button fb-button-light" disabled="@(current >= pages - 1)" @onclick="() => playerPage = current + 1">Next</button>
            </div>
        </div>
        <div class="fb-table-scroll">
            <table class="fb-table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Personality</th>
                    <th>Level</th>
                    <th title="Prestige">Prest.</th>
                    <th>Raids</th>
                    <th title="PMC kills per death">K/D</th>
                    <th>Status</th>
                    <th>For</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in rows.Skip(current * PageSize).Take(PageSize))
                {
                    <tr>
                        <td>
                            <span
                                class="fb-person @(row.Team.Length > 0 ? "fb-in-team" : "")"
                                style="@(row.Team.Length > 0 ? $"--fb-team-hue:{TeamHue(row)}" : null)">
                                <span class="fb-avatar @(row.Side.Equals("Bear", StringComparison.OrdinalIgnoreCase) ? "fb-avatar-bear" : "fb-avatar-usec")">@row.Name[..1].ToUpperInvariant()</span>
                                <span>
                                    <span class="fb-name-line">
                                        @Star(row.Id, row.Name)<button type="button" class="fb-name-link" @onclick="() => OpenPlayer(row.Id)">@row.Name</button>
                                    </span>
                                    @if (row.Team.Length > 0)
                                    {
                                        <span class="fb-team-with">with @string.Join(", ", row.Team)</span>
                                    }
                                    <small>
                                        @row.Side.ToUpperInvariant()@(row.Notable ? " · streamer" : "")
                                        @if (row.Squad.Length > 0)
                                        {
                                            <span
                                                class="fb-squad"
                                                title="Squad with @string.Join(", ", row.Squad)">@Icon("Users") @(row.Squad.Length + 1)</span>
                                        }
                                    </small>
                                </span>
                            </span>
                        </td>
                        <td>@row.Personality</td>
                        <td>@row.Level</td>
                        <td>@row.Prestige</td>
                        <td>@row.Raids.ToString("N0")</td>
                        <td>@row.KillDeath.ToString("0.00")</td>
                        <td>
                            <span class="fb-state fb-state-@row.State.ToLowerInvariant()">
                                <span class="fb-state-label">@StateLabel(row.State)</span><span class="fb-state-detail">@row.Status</span>
                                @if (row.Team.Length > 0)
                                {
                                    <span
                                        class="fb-team"
                                        style="--fb-team-hue:@TeamHue(row)"
                                        title="Playing with @string.Join(", ", row.Team)">@Icon("Users")Team of @(row.Team.Length + 1)</span>
                                }
                            </span>
                        </td>
                        <td class="fb-muted">@(row.Since > 0 ? Duration(row.Since) : "")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
else if (page == "Watching")
{
    @if (watched is not { Players.Count: > 0 } w)
    {
        <section class="fb-card fb-empty">
            <h2>Nobody watched yet</h2>
            <p>Star a player in All players or on their profile to follow them here.</p><button type="button" class="fb-button" @onclick='() => Go("Players")'>Browse players</button>
        </section>
    }
    else
    {
        <div class="fb-watch-grid">
            @foreach (var row in w.Players.OrderBy(r => StateOrder(r.State)).ThenBy(r => r.Name))
            {
                <section class="fb-card fb-watch" @key="row.Id">
                    <div class="fb-person">
                        <span class="fb-avatar @(row.Side.Equals("Bear", StringComparison.OrdinalIgnoreCase) ? "fb-avatar-bear" : "fb-avatar-usec")">@row.Name[..1].ToUpperInvariant()</span>
                        <span>
                            <span class="fb-name-line">
                                @Star(row.Id, row.Name)<button type="button" class="fb-name-link" @onclick="() => OpenPlayer(row.Id)">@row.Name</button>
                            </span><small>Level @row.Level@(row.Prestige > 0 ? $" · prestige {row.Prestige}" : "") · @row.Raids.ToString("N0") raids · K/D @row.KillDeath.ToString("0.00")</small>
                        </span>
                    </div>
                    <p class="fb-person-state">
                        <span class="fb-state fb-state-@row.State.ToLowerInvariant()">
                            <span class="fb-state-label">@StateLabel(row.State)</span><span class="fb-state-detail">@row.Status</span>
                        </span>
                        @if (row.Since > 0)
                        {
                            <span class="fb-muted">for @Duration(row.Since)</span>
                        }
                    </p>
                    @if (row.Team.Length > 0)
                    {
                        <p class="fb-muted fb-watch-team">With @string.Join(", ", row.Team)</p>
                    }
                </section>
            }
        </div>
        <section class="fb-card">
            <div class="fb-card-head">
                <div>
                    <h2>Activity</h2>
                    <p>What your watched players did, newest first.</p>
                </div><span class="fb-live"><span></span>Live</span>
            </div>
            <ol class="fb-log">
                @foreach (var item in w.Events)
                {
                    <li @key="item.Id" class="fb-log-@item.Kind">
                        <span class="fb-log-dot"></span><span class="fb-log-text">@item.Text</span><time>@Ago(item.Utc)</time>
                    </li>
                }
            </ol>
            @if (w.Events.Count == 0)
            {
                <p class="fb-muted">Nothing yet. Their raids, deaths and level-ups show up here.</p>
            }
        </section>
    }
}
else if (page == "Player")
{
    <div class="fb-toolbar">
        <button
            type="button"
            class="fb-button fb-button-light"
            @onclick="() => Go(playerBack)">Back to @Title(playerBack)</button>
    </div>
    @if (profile is not { } p)
    {
        <section class="fb-card">
            <p class="fb-muted">This player no longer exists.</p>
        </section>
    }
    else
    {
        bool bear = p.Side.Equals("Bear", StringComparison.OrdinalIgnoreCase);
        @* Keyed by player so the entrance plays on each profile, not on every live refresh. *@
        <div class="fb-profile" @key="p.Id">
            <section class="fb-card fb-profile-hero @(bear ? "fb-side-bear" : "fb-side-usec")">
                <div class="fb-profile-id">
                    <span class="fb-avatar fb-avatar-lg @(bear ? "fb-avatar-bear" : "fb-avatar-usec")">@p.Name[..1].ToUpperInvariant()</span>
                    <span>
                        <span class="fb-name-line">
                            @Star(p.Id, p.Name)<strong class="fb-profile-name">@p.Name</strong>
                        </span>
                        <span class="fb-profile-tags">
                            <span class="fb-tag">@p.Side.ToUpperInvariant()</span><span class="fb-tag">@p.Personality</span>
                            @if (p.Notable)
                            {
                                <span class="fb-tag fb-tag-gold">Streamer</span>
                            }
                            @if (p.Prestige > 0)
                            {
                                <span class="fb-tag fb-tag-gold">Prestige @p.Prestige</span>
                            }
                            @if (p.BannedUtc > 0)
                            {
                                <span class="fb-tag fb-tag-red">Banned</span>
                            }
                        </span>
                        <p class="fb-person-state">
                            <span class="fb-state fb-state-@p.State.ToLowerInvariant()">
                                <span class="fb-state-label">@StateLabel(p.State)</span><span class="fb-state-detail">@p.Status</span>
                            </span>
                            @if (p.Since > 0)
                            {
                                <span class="fb-muted">for @Duration(p.Since)</span>
                            }
                        </p>
                    </span>
                </div>
                <div class="fb-purse">
                    <div>
                        <span class="fb-stat-label">Wealth</span>@Rubles(p.Wealth, "fb-money-lg")
                    </div>
                    <div>
                        <span class="fb-stat-label">Kit value</span>
                        @if (p.KitValue > 0)
                        {
                            @Rubles(p.KitValue)
                        }
                        else
                        {
                            <span class="fb-money fb-money-none">No kit</span>
                        }
                    </div>
                </div>
            </section>
            <div class="fb-stats fb-profile-stats">
                <article class="fb-card fb-stat">
                    <span class="fb-stat-label">Level</span>
                    <strong>@p.Level</strong>
                    <span class="fb-stat-foot">@p.Experience.ToString("N0") XP@(p.Prestige > 0 ? $" · prestige {p.Prestige}" : "")</span>
                </article>
                <article class="fb-card fb-stat">
                    <span class="fb-stat-label">Raids</span>
                    <strong>@p.Raids.ToString("N0")</strong>
                    <span class="fb-stat-foot">@p.SurvivalRate.ToString("P0") survived</span>
                </article>
                <article class="fb-card fb-stat">
                    <span class="fb-stat-label">K/D</span>
                    <strong>@p.KillDeath.ToString("0.00")</strong>
                    <span class="fb-stat-foot">@p.PmcKills.ToString("N0") PMC kills</span>
                </article>
                <article class="fb-card fb-stat">
                    <span class="fb-stat-label">Time in game</span>
                    <strong>@(p.InGameSeconds / 3600)h</strong>
                    <span class="fb-stat-foot">Registered @(p.RegisteredUtc > 0 ? DateTimeOffset.FromUnixTimeSeconds(p.RegisteredUtc).ToString("d MMM yyyy") : "unknown")</span>
                </article>
            </div>
            @if (p.BannedUtc > 0)
            {
                <section class="fb-card fb-ban-card">
                    <h2>Banned for cheating</h2>
                    <p>@(p.BanReason.Length > 0 ? p.BanReason : "Banned"), @Ago(p.BannedUtc). This account is gone for good.</p>
                </section>
            }
            <section class="fb-card">
                <h2>Raid record</h2>
                <table class="fb-table">
                    <tbody>
                    <tr>
                        <td>Survived</td><td>@p.Survived.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Killed</td><td>@p.Killed.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Missing in action</td><td>@p.MissingInAction.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Left the raid</td><td>@p.Left.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Run through</td><td>@p.RunThrough.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>PMC kills</td><td>@p.PmcKills.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Scav kills</td><td>@p.ScavKills.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Survival streak</td><td>@p.CurrentStreak (best @p.BestStreak)</td>
                    </tr>
                    <tr>
                        <td>Achievements</td><td>@p.Achievements</td>
                    </tr>
                    <tr>
                        <td>Hideout levels built</td><td>@p.HideoutLevels</td>
                    </tr>
                    <tr>
                        <td>Wealth</td><td>@Rubles(p.Wealth)</td>
                    </tr>
                    </tbody>
                </table>
            </section>
            @if (p.Gear.Count > 0)
            {
                <section class="fb-card">
                    <h2>Gear history</h2>
                    <p class="fb-muted">What they bought, rebought and got back from insurance, newest first.</p>
                    <ol class="fb-gear-log">
                        @foreach (var g in p.Gear)
                        {
                            <li class="fb-gear-@g.Kind">
                                <span class="fb-gear-icon">@GearIcon(g.Kind)</span>
                                <span class="fb-gear-text">
                                    @g.Text<time>@Ago(g.Utc)</time>
                                </span>
                                @if (g.Rubles != 0)
                                {
                                    @Rubles(g.Rubles)
                                }
                            </li>
                        }
                    </ol>
                </section>
            }
            @if (p.Squad.Count > 0)
            {
                <section class="fb-card">
                    <h2>Squad</h2>
                    <p>
                        @foreach (var mate in p.Squad)
                        {
                            <button
                                type="button"
                                class="fb-name-link fb-link-chip"
                                @onclick="() => OpenPlayer(mate.Id)">@mate.Name</button>
                        }
                    </p>
                </section>
            }
            @if (p.Events.Count > 0)
            {
                <section class="fb-card">
                    <h2>Recent activity</h2>
                    <ul class="fb-plain-list">
                        @foreach (var ev in p.Events)
                        {
                            <li>
                                <span class="fb-muted">@Ago(ev.Utc)</span> @ev.Text
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
}
else if (page == "Dashboard")
{
    var insights = snapshot.Insights;
    int total = Math.Max(1, snapshot.Careers);
    <div class="fb-stats">
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">Accounts@(Tip("Persistent PMC Players, one per bot name."))</span>
            <strong>@Num("careers", snapshot.Careers)</strong>
            <span class="fb-stat-foot">@Icon("Users") Persistent identities</span>
        </article>
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">Simulated online@(Tip(
                "Accounts playing right now. Each account comes online and logs off around its daily raid hours."))</span>
            <strong>@Num("online-all", snapshot.Online)</strong>
            <span class="fb-stat-foot"><span class="fb-up">@Percent(snapshot.Online, total)</span> of accounts</span>
        </article>
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">Prestiged@(Tip("Accounts that have prestiged at least once."))</span>
            <strong>@Num("prestiged", snapshot.Prestiged)</strong>
            <span class="fb-stat-foot"><span class="fb-up">@Percent(snapshot.Prestiged, total)</span> of accounts</span>
        </article>
        <article class="fb-card fb-stat">
            <span class="fb-stat-label">Pending stories@(Tip(
                "PMCs from your raids whose outcome (a later death, regear, transit or survival) is still to come."))</span>
            <strong>@Num("stories-all", snapshot.PendingStories)</strong>
            <span class="fb-stat-foot">@Icon("Clock") Outcomes awaiting resolution</span>
        </article>
    </div>

    <div class="fb-row fb-row-wide">
        <section class="fb-card">
            <div class="fb-card-head">
                <div>
                    <h2>Accounts by level</h2>
                    <p>Active players in 10-level bands.</p>
                </div><strong class="fb-figure">@insights.LevelBands.Sum().ToString("N0")</strong>
            </div>
            @{ int peak = Math.Max(1, insights.LevelBands.Max()); }
            <div class="fb-bars" role="img" aria-label="Accounts by level band">
                @for (int band = 0; band < insights.LevelBands.Length; band++)
                {
                    int count = insights.LevelBands[band];
                    <div
                        class="fb-bar"
                        title="Level @(band * 10 + 1)-@(band == 7 ? 79 : band * 10 + 10): @count.ToString("N0") accounts">
                        <span class="fb-bar-value">@count.ToString("N0")</span>
                        <span
                            class="fb-bar-fill"
                            style="height:@((count * 100.0 / peak).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                        <span class="fb-bar-label">@(band * 10 + 1)-@(band == 7 ? 79 : band * 10 + 10)</span>
                    </div>
                }
            </div>
            <div class="fb-card-foot">
                <span>Level 1 to 79</span><button type="button" class="fb-link" @onclick="() => Go(simulationPages[0])">Progression settings @Icon("Chevron")</button>
            </div>
        </section>
        <section class="fb-card">
            <div class="fb-card-head">
                <div>
                    <h2>Factions</h2>
                    <p>BEAR and USEC players.</p>
                </div>
            </div>
            @{ double bear = insights.Bear * 100.0 / Math.Max(1, insights.Bear + insights.Usec); }
            <div
                class="fb-donut"
                style="--fb-share:@(bear.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                role="img"
                aria-label="@bear.ToString("0")% BEAR">
                <span>
                    <strong>@bear.ToString("0")%</strong><small>BEAR</small>
                </span>
            </div>
            <ul class="fb-legend">
                <li><span class="fb-swatch fb-swatch-primary"></span>BEAR<strong>@insights.Bear.ToString("N0")</strong></li>
                <li><span class="fb-swatch fb-swatch-secondary"></span>USEC<strong>@insights.Usec.ToString("N0")</strong></li>
            </ul>
        </section>
    </div>

    <div class="fb-row fb-row-wide">
        <section class="fb-card fb-flush">
            <div class="fb-card-head fb-padded">
                <div>
                    <h2>Top players</h2>
                    <p>Highest prestige, then highest level.</p>
                </div>
            </div>
            <div class="fb-table-scroll">
                <table class="fb-table">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Personality</th>
                        <th>Level</th>
                        <th title="Prestige">Prest.</th>
                        <th>Raids</th>
                        <th title="PMC kills per death">K/D</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in insights.TopCareers)
                    {
                        <tr>
                            <td>
                                <span class="fb-person">
                                    <span class="fb-avatar @(row.Side.Equals("Bear", StringComparison.OrdinalIgnoreCase) ? "fb-avatar-bear" : "fb-avatar-usec")">@row.Name[..1].ToUpperInvariant()</span>
                                    <span>
                                        <button
                                            type="button"
                                            class="fb-name-link"
                                            @onclick="() => OpenPlayer(row.Id)">@row.Name</button><small>@row.Side.ToUpperInvariant()</small>
                                    </span>
                                </span>
                            </td>
                            <td>@row.Personality</td>
                            <td>@row.Level</td>
                            <td>@row.Prestige</td>
                            <td>@row.Raids.ToString("N0")</td>
                            <td>@row.KillDeath.ToString("0.00")</td>
                            <td>
                                <span class="fb-status">
                                    <span class="fb-status-dot @(row.Online ? "fb-online" : "")"></span>@(row.Online ? "Online" : "Offline")
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="fb-card">
            <div class="fb-card-head">
                <div>
                    <h2>Personalities</h2>
                    <p>Share of active players.</p>
                </div>
            </div>
            @{ int careers = Math.Max(1, insights.Personalities.Values.Sum()); }
            <ul class="fb-progress-list">
                @foreach (var (name, count) in insights.Personalities)
                {
                    <li>
                        <div>
                            <span>@name</span><span>@count.ToString("N0")</span>
                        </div>
                        <span class="fb-progress">
                            <span style="width:@((count * 100.0 / careers).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                        </span>
                    </li>
                }
            </ul>
            <div class="fb-card-foot">
                <span>@insights.Personalities.Count personalities</span><button type="button" class="fb-link" @onclick='() => Go("Personalities")'>Edit @Icon("Chevron")</button>
            </div>
        </section>
    </div>

    <div class="fb-row">
        <section class="fb-card">
            <div class="fb-card-head">
                <div>
                    <h2>Weapon racks</h2>
                    <p>Accounts with a built weapon rack that show at least one gun.</p>
                </div><strong class="fb-figure">@Percent(insights.RacksFilled, Math.Max(1, insights.RackOwners))</strong>
            </div>
            <span class="fb-progress fb-progress-lg">
                <span style="width:@((insights.RacksFilled * 100.0 / Math.Max(1, insights.RackOwners)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
            </span>
            <p class="fb-muted">@insights.RacksFilled.ToString("N0") of @insights.RackOwners.ToString("N0") racks filled. Empty racks fill when someone opens the profile.</p>
        </section>
        <section class="fb-card">
            <div class="fb-card-head">
                <div>
                    <h2>APBS bridge</h2>
                    <p>@snapshot.GenerationMode</p>
                </div>
            </div>
            <dl class="fb-dl">
                <div>
                    <dt>Player selections</dt><dd>@snapshot.ApbsMatched.ToString("N0")</dd>
                </div>
                <div>
                    <dt>Unmatched level ranges</dt><dd>@snapshot.ApbsFallback.ToString("N0")</dd>
                </div>
            </dl>
            <p class="fb-muted">APBS supplies equipment and appearance. Players keep their identity, history and friendships
                between raids.</p>
        </section>
    </div>
}
else if (page == "Personalities")
{
    <section class="fb-card">
        <div class="fb-toolbar">
            <label class="fb-field">
                Selected personality
                <select @bind="selectedIndex">
                    @for (int index = 0; index < people.Count; index++)
                    {
                        <option value="@index">@people[index].Id</option>
                    }
                </select>
            </label><button type="button" class="fb-button fb-button-light" @onclick="Add">@Icon("Plus") Add personality</button>
        </div>
    </section>
    @if (Current is { } p)
    {
        <section class="fb-card">
            <h2>Identity &amp; distribution</h2>
            <div class="fb-grid">
                <label class="fb-field">
                    <span class="fb-label">Name@(Tip(
                        "Personality ID. Players store this name, so renaming it moves existing players to the first "
                        + "personality."))</span>
                    <input @bind="p.Id"/>
                </label>
                <label class="fb-field">
                    <span class="fb-label">Population weight@(Tip(
                        "How often new accounts roll this personality, relative to the other weights."))</span>
                    <input type="number" min="1" max="1000" @bind="p.Weight"/>
                </label>
            </div>
        </section>
        <section class="fb-card">
            <h2>Starting experience</h2>
            <p class="fb-muted">Ranges used when a new account is created. Raids, hours and kills are worked out from the
                level, so they always fit it.</p>
            <div class="fb-grid">
                <label class="fb-field">
                    <span class="fb-label">Starting level, minimum@(Tip(
                        "Lowest level a new account of this personality starts at."))</span>
                    <input type="number" min="1" max="79" @bind="p.MinimumLevel"/>
                </label>
                <label class="fb-field">
                    <span class="fb-label">Starting level, maximum@(Tip(
                        "Highest level a new account of this personality starts at."))</span>
                    <input type="number" min="1" max="79" @bind="p.MaximumLevel"/>
                </label>
            </div>
        </section>
        <section class="fb-card">
            <h2>Raid behavior</h2>
            <p class="fb-muted">Hours are daily totals. Survival chances use 0 to 1 (0.5 = 50%).</p>
            <div class="fb-grid">
                <label class="fb-field">
                    <span class="fb-label">Daily raid hours, minimum@(Tip(
                        "Least time per day this account plays. It also sets how often the account shows as online."))</span>
                    <input type="number" step="0.05" @bind="p.MinimumDailyHours"/>
                </label>
                <label class="fb-field">
                    <span class="fb-label">Daily raid hours, maximum@(Tip(
                        "Most time per day this account plays. It also sets how often the account shows as online."))</span>
                    <input type="number" step="0.05" @bind="p.MaximumDailyHours"/>
                </label>
                <label class="fb-field">
                    <span class="fb-label">Survival chance, minimum@(Tip(
                        "Survival chance (0 to 1) of the least skilled accounts. Skill also sets kills, so low survival "
                        + "means fewer kills."))</span>
                    <input type="number" min="0" max="1" step="0.01" @bind="p.MinimumSurvival"/>
                </label>
                <label class="fb-field">
                    <span class="fb-label">Survival chance, maximum@(Tip(
                        "Survival chance (0 to 1) of the most skilled accounts."))</span>
                    <input type="number" min="0" max="1" step="0.01" @bind="p.MaximumSurvival"/>
                </label>
                <label class="fb-field">
                    <span class="fb-label">Raid minutes, minimum@(Tip("Shortest simulated raid. Clamped to 3-60 minutes."))</span>
                    <input type="number" @bind="p.MinimumRaidMinutes"/>
                </label>
                <label class="fb-field">
                    <span class="fb-label">Raid minutes, maximum@(Tip("Longest simulated raid. Clamped to 3-60 minutes."))</span>
                    <input type="number" @bind="p.MaximumRaidMinutes"/>
                </label>
            </div>
        </section>
        <section class="fb-card">
            <h2>Personality progression</h2>
            <div class="fb-grid">
                <label class="fb-field">
                    <span class="fb-label">Progress to@(Tip(
                        "Personality this account turns into after enough raid hours, e.g. Timmy into Casual."))</span>
                    <select @bind="p.ProgressTo">
                        <option value="">Stay this personality</option>
                        @foreach (var target in people.Where(t => t != p))
                        {
                            <option value="@target.Id">@target.Id</option>
                        }
                    </select>
                </label>
                <label class="fb-field">
                    <span class="fb-label">Progress after account raid hours@(Tip(
                        "Total raid hours before the account switches to the Progress to personality."))</span>
                    <input type="number" @bind="p.TransitionHours"/>
                </label>
            </div>
        </section>
        <section class="fb-card fb-danger-zone">
            <h2>Remove personality</h2>
            <p class="fb-muted">Removes @p.Id from this draft. Save personalities to apply the removal.</p><button type="button" class="fb-button fb-button-red" @onclick="Remove">Remove @p.Id</button>
        </section>
    }

    <div class="fb-savebar">
        <span>Starting ranges apply to new accounts. Progression targets affect existing accounts.</span><button type="button" class="fb-button" disabled="@(!Dirty("personalities"))" @onclick="SavePeople">Save personalities</button>
    </div>
}
else if (page == "Progression")
{
    <section class="fb-card fb-flush">
        <div class="fb-card-head fb-padded">
            <div>
                <h2>Raid history priors</h2>
                <p>Bands must increase and end at level 79. These averages are priors, not identical targets for every
                    account.</p>
            </div>
        </div>
        <div class="fb-table-scroll">
            <table class="fb-table">
                <thead>
                <tr>
                    <th>Maximum level</th>
                    <th title="Average length of a raid the account survives.">Survived raid min</th>
                    <th title="Average length of a raid that ends in death.">Death raid min</th>
                    <th title="For an average-skill account. Skill and personality scale it.">PMC kills / raid</th>
                    <th title="For an average-skill account. Skill and personality scale it.">Scav kills / raid</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var prior in simulation.ProgressionPriors)
                {
                    var row = simulation.ProgressionPriors.IndexOf(prior) + 1;
                    <tr @key="prior">
                        <td>
                            <input
                                aria-label="Maximum level, band @row"
                                type="number"
                                min="1"
                                max="79"
                                @bind="prior.MaximumLevel"/>
                        </td>
                        <td>
                            <input
                                aria-label="Survived raid minutes, band @row"
                                type="number"
                                min="3"
                                max="60"
                                step="0.5"
                                @bind="prior.SurvivedMinutes"/>
                        </td>
                        <td>
                            <input
                                aria-label="Death raid minutes, band @row"
                                type="number"
                                min="3"
                                max="60"
                                step="0.5"
                                @bind="prior.DeathMinutes"/>
                        </td>
                        <td>
                            <input
                                aria-label="PMC kills per raid, band @row"
                                type="number"
                                min="0"
                                max="20"
                                step="0.01"
                                @bind="prior.PmcKills"/>
                        </td>
                        <td>
                            <input
                                aria-label="Scav kills per raid, band @row"
                                type="number"
                                min="0"
                                max="20"
                                step="0.01"
                                @bind="prior.ScavKills"/>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    <section class="fb-card">
        <h2>Raid experience &amp; time</h2>
        <p class="fb-muted">With the defaults an average account needs about 60 raids for level 15, 440 for level 40 and
            3,800 for level 79.</p>
        <div class="fb-grid">
            <label class="fb-field">
                <span class="fb-label">Survived raid XP, base@(Tip(
                    "XP for a survived raid at level 0. Raid XP decides how many raids an account needed to reach its "
                    + "level."))</span>
                <input type="number" min="100" max="100000" step="100" @bind="simulation.RaidExperience.SurvivedBase"/>
            </label>
            <label class="fb-field">
                <span class="fb-label">Survived raid XP, per level@(Tip("Extra survived raid XP per level."))</span>
                <input type="number" min="0" max="10000" step="10" @bind="simulation.RaidExperience.SurvivedPerLevel"/>
            </label>
            <label class="fb-field">
                <span class="fb-label">Survived raid XP, per level squared@(Tip(
                    "Extra survived raid XP per level squared, so high levels earn much more per raid."))</span>
                <input type="number" min="0" max="1000" step="0.5" @bind="simulation.RaidExperience.SurvivedPerLevelSquared"/>
            </label>
            <label class="fb-field">
                <span class="fb-label">Death XP share@(Tip("Share (0 to 1) of the survived XP a death still earns."))</span>
                <input type="number" min="0" max="1" step="0.05" @bind="simulation.RaidExperience.DeathShare"/>
            </label>
            <label class="fb-field">
                <span class="fb-label">Online time factor, minimum@(Tip(
                    "Online time is raid time times a factor between these two, for menus, hideout and flea."))</span>
                <input type="number" min="1" max="5" step="0.05" @bind="simulation.OnlineTimeMinimum"/>
            </label>
            <label class="fb-field">
                <span class="fb-label">Online time factor, maximum@(Tip("Upper end of the online time factor."))</span>
                <input type="number" min="1" max="5" step="0.05" @bind="simulation.OnlineTimeMaximum"/>
            </label>
        </div>
    </section>
    <section class="fb-card">
        <h2>Achievements</h2>
        <p class="fb-muted">Share of level 79, average-skill accounts that own a given achievement. Lower levels own fewer,
            skill scales it.</p>
        <div class="fb-grid fb-grid-3">
            <label class="fb-field">
                <span class="fb-label">Common@(Tip(
