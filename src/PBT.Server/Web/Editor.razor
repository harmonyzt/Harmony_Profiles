        "Overview" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 5.5 7 3.5l6 2 4.5-2v11l-4.5 2-6-2-4.5 2ZM7 3.5v11M13 5.5v11" /></svg>,
        "Players" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h9" /><circle cx="15.5" cy="15" r="1.5" /></svg>,
        "Personalities" or "Users" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="7.5" cy="7" r="3" /><path d="M2 17a5.5 5.5 0 0 1 11 0M13 4.2a3 3 0 0 1 0 5.6M15 12a5.5 5.5 0 0 1 3 5" /></svg>,
        "Simulation" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="2.5" /><path d="M10 2v3M10 15v3M2 10h3M15 10h3M4.3 4.3l2.1 2.1M13.6 13.6l2.1 2.1M4.3 15.7l2.1-2.1M13.6 6.4l2.1-2.1" /></svg>,
        "Population" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M2.5 10h15M10 2.5c2.2 2.2 2.2 12.8 0 15M10 2.5c-2.2 2.2-2.2 12.8 0 15" /></svg>,
        "GitHub" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 17c-4 1.2-4-2-5.5-2.5M13 18.5v-2.8a2.4 2.4 0 0 0-.7-1.9c2.3-.3 4.7-1.1 4.7-5.1a4 4 0 0 0-1.1-2.7 3.7 3.7 0 0 0-.1-2.7s-.9-.3-2.9 1.1a10 10 0 0 0-5.2 0C5.7 3 4.8 3.3 4.8 3.3a3.7 3.7 0 0 0-.1 2.7A4 4 0 0 0 3.6 8.7c0 4 2.4 4.8 4.7 5.1a2.4 2.4 0 0 0-.7 1.8v2.9" /></svg>,
        "Reload" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.5 10A6.5 6.5 0 1 1 14.6 5.4M16.5 3v3.5H13" /></svg>,
        "Home" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.5 10 3l7 6.5M5 8v8.5h4V12h2v4.5h4V8" /></svg>,
        "Clock" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="M10 6v4l2.5 2.5" /></svg>,
        "Presets" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 3.5h12v13H4ZM7 7h6M7 10h6M7 13h3" /></svg>,
