    private static string? Section(string page) => page switch {
        "Personalities" => "personalities", "Population" => "settings", "Dashboard" or "Overview" or "Players" or "Presets" => null, _ => "simulation" };
    // preventDefault keeps a click on the icon from toggling or focusing the label's control.
    private static RenderFragment Tip(string text) => @<span class="fb-tip" tabindex="0" @onclick:preventDefault="true"><span aria-hidden="true">?</span><span class="fb-tip-text" role="tooltip">@text</span></span>;
    private static string Percent(int part, int whole) => (part * 100.0 / whole).ToString("0.0") + "%";
    private static RenderFragment SubIcon(string name) => name switch {
        "Progression" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 14l5-5 3 3 6-6M12 6h5v5" /></svg>,
        "Hideout" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.5 10 3l7 6.5M5 8v8.5h10V8M8.5 16.5V12h3v4.5" /></svg>,
        "Gear" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7h14v9H3zM7.5 7V5h5v2M3 11h14" /></svg>,
