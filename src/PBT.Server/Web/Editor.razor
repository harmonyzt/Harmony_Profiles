                                            else
                                            {
                                                <button type="button" class="fb-button fb-button-light" @onclick="() => confirmDelete = preset.Name">Delete</button>
                                            }
                                        }
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="fb-card"><h2>Save current settings</h2><p class="fb-muted">Saves every page's current values, unsaved edits included, applies them and makes the preset active.</p>
                <div class="fb-toolbar">
                    <label class="fb-field"><span class="fb-label">New preset name</span><input maxlength="40" placeholder="My preset" @bind="presetName" @bind:event="oninput" /></label>
                    <button type="button" class="fb-button" disabled="@(string.IsNullOrWhiteSpace(presetName))" @onclick="() => SavePreset(presetName, false)">Save as new preset</button>
                    @if (active is { BuiltIn: false })
