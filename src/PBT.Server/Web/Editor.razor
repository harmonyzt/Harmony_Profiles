    private readonly Dictionary<string, double> shownNumbers = new(), targetNumbers = new();
    private string page = "Overview", message = "", playerSearch = "", playerFilter = "", playerSort = "Status";
    private int selectedIndex, slide, playerPage, ticks;
    private bool error, confirmReload, dark = true, menuOpen, simulationOpen = true, sortDescending, animating, slideHeld, slideHover;
    private System.Threading.Timer? live;
    private PlayerProfile? profile;
    private string playerId = "", playerBack = "Players", streamerName = "", streamerSide = "Usec";

    private void OpenPlayer(string id)
    {
        string from = page == "Player" ? playerBack : page;
        Go("Player");
        playerBack = from;
        playerId = id;
        LoadProfile();
