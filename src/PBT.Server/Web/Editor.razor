                </label>
                <label class="fb-field">
                    <span class="fb-label">Cheater rivalry@(Tip(
                        "Chance (0 to 1) a cheater that spots another cheater goes after it instead, and the other one "
                        + "fights back. Two rage cheaters meeting is a show."))</span>
                    <input type="number" min="0" max="1" step="0.05" @bind="play.Rivalry"/>
                </label>
            </div>
        </section>
        @if (!perType)
        {
        <section class="fb-card">
            <h2>Shared chances</h2>
