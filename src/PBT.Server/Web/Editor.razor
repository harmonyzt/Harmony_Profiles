        "Prestige" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="8" r="4.5" /><path d="m7.5 11.8-1 5.7 3.5-2 3.5 2-1-5.7" /></svg>,
        "Stories" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3h8l3 3v11H5ZM13 3v3h3M7.5 10h5M7.5 13h5" /></svg>,
