        {
            <h3>Recent bans</h3>
            <ul class="fb-plain-list">
                @foreach (var ban in bans)
                {
                    <li>
                        <span class="fb-muted">@Ago(ban.BannedUtc)</span>
                        <button type="button" class="fb-name-link" @onclick="() => OpenPlayer(ban.Id)">@ban.Name</button>
                        <span class="fb-muted">@ban.Reason</span>
                    </li>
                }
            </ul>
        }
    </section>
    <section class="fb-card">
        <h2>Debug</h2>
        <div class="fb-grid">
            <label class="fb-field">
                <span class="fb-label">Cheaters per raid@(Tip(
                    "This many of the first PMCs generated for each of your raids are cheaters, whatever their level. A "
                    + "career only borrowed for this keeps its own kit and is back to normal after the raid. Pair with the "
                    + "client's Cheaters (debug) settings in the BepInEx config. 0 is off."))</span>
                <input type="number" min="0" max="30" @bind="simulation.Cheaters.DebugCheatersPerRaid"/>
            </label>
        </div>
    </section>
    @SimulationSave
}
else if (page == "Prestige")
