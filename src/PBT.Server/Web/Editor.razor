            <section class="fb-card"><h2>Friendships</h2>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="config.EnableFriendRequests" /><span class="fb-switch-track"></span>Bot friend requests@(Tip("Allow sending friend requests to simulated accounts."))</label></div>
                <div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Friend acceptance chance@(Tip("Chance (0 to 1) that a simulated account accepts your friend request."))</span><input type="number" min="0" max="1" step="0.01" @bind="config.FriendAcceptanceChance" /></label>
                    <label class="fb-field"><span class="fb-label">Friend activity multiplier@(Tip("Accepted friends play and show online this many times as often as other accounts."))</span><input type="number" min="0" max="5" step="0.1" @bind="config.FriendActivityMultiplier" /></label>
                </div><p class="fb-hint">Disabling new friend requests keeps existing accepted friendships.</p>
