@code {
    private static readonly string[] topPages =
    [
        "Overview",
        "Dashboard",
        "Players",
        "Watching",
        "Personalities",
        "Simulation",
        "Population",
        "Presets",
    ];

    private static readonly string[] simulationPages =
    [
        "Progression",
        "Hideout",
        "Gear",
        "Notable",
        "Cheaters",
        "Prestige",
        "Stories",
        "Messages",
        "World",
    ];

    private static readonly (string Value, string Label)[] statusFilters =
    [
        ("", "Everyone"),
        ("Online", "Online"),
        ("Raid", "In raid"),
        ("Queue", "Queueing"),
        ("Menu", "Main menu"),
        ("Afk", "AFK"),
        ("Transit", "In transit"),
        ("Died", "Died"),
        ("Offline", "Offline"),
        ("Squad", "In a squad"),
        ("Favorites", "Watched"),
        ("Banned", "Banned"),
    ];


    private static readonly string[] sortOptions = ["Status", "Name", "Level", "Prestige", "Raids", "K/D"];
    private const int PageSize = 50;
    private EditorSnapshot? snapshot;
    private WorldSnapshot? world;
    private List<WorldPlayerRow> players = new();
    private List<PersonalityTemplate> people = new();
    private List<PresetInfo> presets = new();
    private string presetName = "", confirmPreset = "", confirmDelete = "";
    private SimulationPolicy simulation = new();
    private PbtSettings config = new();
    private readonly Dictionary<string, string> baselines = new();
    private readonly Dictionary<string, double> shownNumbers = new(), targetNumbers = new();
    private string page = "Overview", message = "", playerSearch = "", playerFilter = "", playerSort = "Status";
    private int selectedIndex, slide, playerPage, ticks;
    private bool error, confirmReload, dark = true, menuOpen, simulationOpen = true, sortDescending, animating, slideHeld, slideHover;
    private System.Threading.Timer? live;
    private PlayerProfile? profile;
    private WatchedPlayers? watched;
    private HashSet<string> favorites = new();
    private string playerId = "", playerBack = "Players", streamerName = "", streamerSide = "Usec";

    private void OpenPlayer(string id)
    {
        string from = page == "Player" ? playerBack : page;
        Go("Player");
        playerBack = from;
        playerId = id;
        LoadProfile();
    }

    private void LoadProfile()
    {
        try
        {
            profile = Store.GetPlayerProfile(playerId);
        }
        catch
        {
            profile = null;
        }
    }

    private void LoadWatched()
    {
        try
        {
            watched = Store.GetWatched(40);
            favorites = Store.GetFavorites();
        }
        catch
        {
        }
    }

    private void ToggleFavorite(string id)
    {
        try
        {
            Store.SetFavorite(id, !favorites.Contains(id));
            favorites = Store.GetFavorites();
        }
        catch (Exception ex)
        {
            Notify(true, "Could not save the watch list: " + ex.Message);
            return;
        }

        if (page == "Watching") LoadWatched();
    }

    private RenderFragment Star(string id, string name) =>
        @<button type="button" class="fb-star @(favorites.Contains(id) ? "fb-starred" : "")" aria-pressed="@(favorites.Contains(id) ? "true" : "false")"
                 title="@(favorites.Contains(id) ? $"Stop watching {name}" : $"Watch {name}")" @onclick="() => ToggleFavorite(id)">
            <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="m10 2.8 2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L2.8 8.1l5-.7Z"/>
            </svg>
        </button>;

    private void AddStreamer()
    {
        var (ok, restart, text) = Store.CheckStreamerName(streamerName, streamerSide);
        if (ok)
        {
            string name = streamerName.Trim();
            var extraNames = simulation.NotableNames.ExtraNames;
            if (!extraNames.Contains(name, StringComparer.OrdinalIgnoreCase))
                extraNames.Add(name);
            streamerName = "";
        }

        Notify(!ok, text);
        if (ok && restart)
        {
            noticeTimer?.Cancel();
            error = false;
            message = text;
        }
    }

    private RenderFragment SimulationSave => @<div class="fb-savebar">
                                                 <span>Saves every Simulation page at once.</span><button type="button" class="fb-button" disabled="@(!Dirty("simulation"))" @onclick="SavePolicy">Save simulation policy</button>
                                             </div>;

    private static string Title(string page) =>
        page switch
        {
            "Gear" => "APBS & gear",
            "Notable" => "Chads & streamers",
            "Stories" => "Post-raid stories",
            "Messages" => "Bot messages",
            "Players" => "All players",
            "World" => "Maps & matching",
            "Player" => "Player",
            "Watching" => "Watching",
            _ => page
        };

    private static string Heading(string page) =>
        page switch
        {
            "Overview" => "Live world",
            "Dashboard" => "Population dashboard",
            "Player" => "Player profile",
            "Population" => "Population settings",
            _ => Title(page)
        };

    private static string Description(string page) =>
        page switch
        {
            "Overview" => "Who's online, where they're playing and what just happened. Updates live.",
            "Dashboard" => "A snapshot of your server's persistent population.",
            "Player" => "This account's profile stats, wealth and gear history. Updates live.",
            "Players" => "Every player: what it's doing right now, who it plays with and how it has done.",
            "Watching" => "Players you starred: where they are right now and what they've been up to. Updates live.",
            "World" => "Map popularity, queues, transits and the matching screen.",
            "Personalities" => "Starting ranges and progression targets. Edits affect future simulation without rerolling existing accounts.",
            "Progression" => "Level cohorts guide varied account histories. Native requirements remain in force.",
            "Hideout" => "How simulated accounts build and upgrade their hideout.",
            "Gear" => "APBS takeover, profile loadouts and weapon racks.",
            "Notable" => "Better stats and gear for chad and streamer names.",
            "Cheaters" => "Cheater accounts, their kits, in-raid cheating and bans.",
            "Prestige" => "When simulated accounts prestige, and how many start prestiged.",
            "Stories" => "What happens to the PMCs from your raid after it ends.",
            "Messages" => "Rare post-raid messages from players you met.",
            "Presets" => "Named sets of every setting. Load one, tweak anything, then save it under a new name.",
            _ => "Friendships and activity between server sessions."
        };

    private static string? Section(string page) =>
        page switch
        {
            "Personalities" => "personalities",
            "Population" => "settings",
            "Dashboard" or "Overview" or "Players" or "Watching" or "Presets" => null,
            _ => "simulation"
        };

    // preventDefault keeps a click on the icon from toggling or focusing the label's control.
    private static RenderFragment Rubles(double value, string css = "") =>
        @<span class="fb-money @(value < 0 ? "fb-money-loss" : "") @css">
            @value.ToString("N0")<span class="fb-money-unit">₽</span>
        </span>;

    private static RenderFragment GearIcon(string kind) =>
        kind switch
        {
            "upgrade" => @<svg viewBox="0 0 20 20" aria-hidden="true">
                             <path d="M10 4 4 11h4v5h4v-5h4Z"/>
                         </svg>,
            "insurance" => @<svg viewBox="0 0 20 20" aria-hidden="true">
                               <path d="M10 2.5 3.5 5v4.5c0 4 2.8 6.9 6.5 8 3.7-1.1 6.5-4 6.5-8V5Z"/>
                           </svg>,
            _ => @<svg viewBox="0 0 20 20" aria-hidden="true">
                     <path d="M15.5 6.5A6.5 6.5 0 1 0 16.4 12h-2.1a4.5 4.5 0 1 1-1-4.3L11 10h6V4Z"/>
                 </svg>
        };

    // Starting points for how rough cheaters are. Normal is the shipped default.
    private void CheaterPreset(string level)
    {
        var mode = simulation.Cheaters.Play.Mode;
        var next = CheaterPresetValues(level);
        next.Mode = mode;
        foreach (var type in CheaterRules.Types)
            SetPersonality(next.Personalities, type, CheaterRules.Seed(type, next));
        simulation.Cheaters.Play = next;
    }

    private static CheaterPlaySettings CheaterPresetValues(string level) => level switch
    {
        "mild" => new CheaterPlaySettings
        {
            Types = new CheaterTypeShares { Closet = .55, Looter = .3, Hunter = .1, Rage = .02, Troll = .03 },
            Esp = .4, Aimbot = .3, Godmode = 0, Speedhack = .2, SpeedMultiplier = 1.6, Spinbot = .05, BunnyHop = .1, FightTeleport = .05, Fly = 0, Vacuum = .5, Stalker = .05,
            VoiceSpam = .3, TargetsYou = .2, BanPerMinute = .05, AimAccuracy = .45, ReactionTime = 1.5
        },
        "brutal" => new CheaterPlaySettings
        {
            Types = new CheaterTypeShares { Closet = .15, Looter = .1, Hunter = .3, Rage = .35, Troll = .1 },
            Esp = .8, Aimbot = .95, Godmode = .4, Speedhack = .6, SpeedMultiplier = 3, Spinbot = .35, BunnyHop = .35, FightTeleport = .5, Fly = .15, Vacuum = .7, Stalker = .2,
            VoiceSpam = .6, TargetsYou = .7, BanPerMinute = .005, AimAccuracy = .9, ReactionTime = .75
        },
        _ => new CheaterPlaySettings()
    };

    private CheaterOverview? cheaterOverview;

    private void LoadCheaters()
    {
        try
        {
            cheaterOverview = Store.GetCheaterOverview();
        }
        catch
        {
        }
    }

    private static void SetPersonality(CheaterPersonalities all, string type, CheaterPersonality p)
    {
        switch (type)
        {
            case CheaterRules.Looter: all.Looter = p; break;
            case CheaterRules.Hunter: all.Hunter = p; break;
            case CheaterRules.Rage: all.Rage = p; break;
            case CheaterRules.Troll: all.Troll = p; break;
            default: all.Closet = p; break;
        }
    }

    private void CopySharedIntoPersonalities()
    {
        var play = simulation!.Cheaters.Play;
        foreach (var type in CheaterRules.Types)
            SetPersonality(play.Personalities, type, CheaterRules.Seed(type, play));
    }

    private static string Invariant(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static double? ParseInput(object? value) =>
        double.TryParse(value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double d)
        && double.IsFinite(d)
            ? d
            : null;

    private void SetWeight(string type, object? value)
    {
        if (ParseInput(value) is not { } v)
            return;
        var play = simulation!.Cheaters.Play;
        if (play.Mode == CheaterRules.PerType)
        {
            play.Personalities.Get(type).Weight = Math.Clamp(v, 0, 100);
            return;
        }

        v = Math.Clamp(v, 0, 1);
        switch (type)
        {
            case CheaterRules.Looter: play.Types.Looter = v; break;
            case CheaterRules.Hunter: play.Types.Hunter = v; break;
            case CheaterRules.Rage: play.Types.Rage = v; break;
            case CheaterRules.Troll: play.Types.Troll = v; break;
            default: play.Types.Closet = v; break;
        }
    }

    private void SetChance(string type, string cheat, object? value)
    {
        if (ParseInput(value) is { } v)
            CheaterRules.SetChance(simulation!.Cheaters.Play.Personalities.Get(type), cheat, Math.Clamp(v, 0, 1));
    }

    private void SetTuning(string type, string key, object? value)
    {
        if (ParseInput(value) is not { } v)
            return;
        var p = simulation!.Cheaters.Play.Personalities.Get(type);
        switch (key)
        {
            case "AimAccuracy": p.AimAccuracy = Math.Clamp(v, 0, 1); break;
            case "ReactionTime": p.ReactionTime = Math.Clamp(v, .5, 3); break;
            default: p.SpeedMultiplier = Math.Clamp(v, 1, 6); break;
        }
    }

