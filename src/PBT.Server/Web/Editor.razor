@page "/pbt"
@namespace PBT.Server.Web
@using PBT.Server
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@layout SPTarkov.Server.Web.Layout.BaseMainLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>PBT - Progressive Bot Profiles</PageTitle>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet" />
<link href="/pbt-assets/pbt.css?v=20261102-squads" rel="stylesheet" />
<div class="pbt-editor" data-theme="@(dark ? "dark" : "light")">
    <nav class="fb-topbar">
        <button type="button" class="fb-icon-button fb-menu" aria-label="Toggle navigation" aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => menuOpen = !menuOpen">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
        </button>
        <span class="fb-brand"><span class="fb-logo" aria-hidden="true">P</span><span>PBT</span><small>Progressive Bot Profiles</small></span>
        <span class="fb-spacer"></span>
        @if (snapshot is null) { <span class="fb-pill fb-pill-red"><span class="fb-pill-dot" aria-hidden="true"></span>Settings unavailable</span> }
        <button type="button" class="fb-icon-button" title="@(dark ? "Switch to light mode" : "Switch to dark mode")" aria-label="Toggle dark mode" @onclick="() => dark = !dark">
            @if (dark)
            {
                <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.5" /><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4" /></svg>
            }
            else
            {
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 12.5A7 7 0 0 1 7.5 4a7 7 0 1 0 8.5 8.5Z" /></svg>
            }
        </button>
    </nav>

    <aside class="fb-sidebar @(menuOpen ? "fb-open" : "")" aria-label="PBT sections">
        <ul class="fb-nav">
            @foreach (var item in topPages)
            {
                @if (item == "Simulation")
                {
                    <li>
                        <button type="button" class="fb-nav-item @(simulationPages.Contains(page) ? "fb-parent-active" : "")" aria-expanded="@(simulationOpen ? "true" : "false")" @onclick="() => simulationOpen = !simulationOpen">
                            @Icon("Simulation")<span class="fb-nav-label">Simulation</span>
                            @if (Dirty("simulation")) { <span class="fb-dot" aria-hidden="true"></span><span class="fb-sr-only">, unsaved changes</span> }
                            <svg class="fb-chevron @(simulationOpen ? "fb-rotated" : "")" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4" /></svg>
                        </button>
                        @if (simulationOpen)
                        {
                            <ul class="fb-subnav">
                                @foreach (var sub in simulationPages)
                                {
                                    <li><button type="button" class="fb-nav-item @(page == sub ? "fb-active" : "")" aria-current="@(page == sub ? "page" : null)" @onclick="() => Go(sub)">@Title(sub)</button></li>
                                }
                            </ul>
                        }
                    </li>
                }
                else
                {
                    <li>
                        <button type="button" class="fb-nav-item @(page == item ? "fb-active" : "")" aria-current="@(page == item ? "page" : null)" @onclick="() => Go(item)">
                            @Icon(item)<span class="fb-nav-label">@Title(item)</span>
                            @if (PageDirty(item)) { <span class="fb-dot" aria-hidden="true"></span><span class="fb-sr-only">, unsaved changes</span> }
                        </button>
                    </li>
                }
            }
        </ul>
        <ul class="fb-nav fb-nav-secondary">
            <li><a class="fb-nav-item" href="https://github.com/harmonyzt/Harmony_Profiles" target="_blank" rel="noopener">@Icon("GitHub")<span class="fb-nav-label">GitHub repository</span></a></li>
            <li><button type="button" class="fb-nav-item" @onclick="RequestReload">@Icon("Reload")<span class="fb-nav-label">Reload saved settings</span></button></li>
        </ul>
    </aside>
    @if (menuOpen) { <div class="fb-backdrop" @onclick="() => menuOpen = false"></div> }

    <main class="fb-content">
        <ol class="fb-breadcrumb" aria-label="Breadcrumb">
            <li>@Icon("Home")PBT</li>
            @if (simulationPages.Contains(page)) { <li>Simulation</li> }
            <li aria-current="page">@Title(page)</li>
        </ol>
        <div class="fb-page-heading">
            <div><h1>@Heading(page)</h1><p>@Description(page)</p></div>
            @if (page == "Dashboard" && snapshot is not null)
            {
                <button type="button" class="fb-button fb-button-light" @onclick="RefreshStatus">@Icon("Reload") Refresh status</button>
            }
            else if (Section(page) is { } section)
            {
                <span class="fb-badge @(Dirty(section) ? "fb-badge-yellow" : "fb-badge-green")">@(Dirty(section) ? "Unsaved changes" : "Saved")</span>
            }
        </div>

        @if (confirmReload)
        {
            <div class="fb-alert fb-alert-yellow" role="alertdialog" aria-label="Discard unsaved settings">
                <div><strong>Discard unsaved changes?</strong> Every section with edits goes back to the saved settings.</div>
                <div class="fb-actions"><button type="button" class="fb-button fb-button-red" @onclick="Reload">Discard and reload</button><button type="button" class="fb-button fb-button-light" @onclick="() => confirmReload = false">Keep editing</button></div>
            </div>
        }
        @if (!string.IsNullOrEmpty(message))
        {
            <div role="status" aria-live="polite" class="fb-alert @(error ? "fb-alert-red" : "fb-alert-green")">@message</div>
        }

        @if (snapshot is null)
        {
            <section class="fb-card fb-empty"><h2>Settings are unavailable</h2><p>The population store could not be loaded. Try again when the server is ready.</p><button type="button" class="fb-button" @onclick="Reload">Try again</button></section>
        }
        else if (page == "Overview")
        {
            var maps = world?.Maps ?? [];
            <section class="fb-hero" aria-label="Maps">
                <div class="fb-hero-track" style="transform:translateX(-@(slide * 100)%)">
                    @foreach (var map in maps)
                    {
                        <article class="fb-slide" @key="map.Id" style="--fb-map-hue:@Hue(map.Id);background-image:url('/pbt-assets/maps/@(map.Id).jpg'),linear-gradient(135deg,hsl(@Hue(map.Id) 35% 28%),hsl(@((Hue(map.Id) + 40) % 360) 30% 12%))">
                            <div class="fb-slide-shade"></div>
                            <div class="fb-slide-body">
                                @if (map.WeeklyBoss) { <span class="fb-badge fb-badge-yellow">Weekly boss</span> }
                                @if (map.Solo) { <span class="fb-badge fb-badge-green">Solo instance</span> }
                                <h2 class="fb-slide-name">@map.Name</h2>
                                <ul class="fb-slide-stats">
                                    <li><strong>@Num("slide-raid-" + map.Id, map.InRaid)</strong><span>in raid</span></li>
                                    <li><strong>@Num("slide-queue-" + map.Id, map.Queueing)</strong><span>queueing</span></li>
                                    <li><strong>@Clock(map.QueueSeconds)</strong><span>avg queue</span></li>
                                    <li><strong>@((map.Share * 100).ToString("0"))%</strong><span>of players</span></li>
                                </ul>
                            </div>
                        </article>
                    }
                </div>
                @if (maps.Count > 1)
                {
                    <div class="fb-hero-dots">
                        @for (int index = 0; index < maps.Count; index++)
                        {
                            int target = index;
                            <button type="button" class="@(index == slide ? "fb-dot-active" : "")" aria-label="Show @maps[index].Name" @onclick="() => slide = target"></button>
                        }
                    </div>
                }
            </section>

            <div class="fb-stats fb-stats-6">
                <article class="fb-card fb-stat"><span class="fb-stat-label">Online@(Tip("Careers playing right now: in the menu, queueing, in a raid or in transit."))</span><strong>@Num("online", world?.Online ?? 0)</strong></article>
                <article class="fb-card fb-stat"><span class="fb-stat-label">In raid@(Tip("Careers in a raid, including the ones in yours."))</span><strong>@Num("raid", world?.InRaid ?? 0)</strong></article>
                <article class="fb-card fb-stat"><span class="fb-stat-label">Queueing@(Tip("Careers waiting for a match. Busy maps fill faster."))</span><strong>@Num("queue", world?.Queueing ?? 0)</strong></article>
                <article class="fb-card fb-stat"><span class="fb-stat-label">Main menu@(Tip("Online between raids: sorting the stash, regearing, flea."))</span><strong>@Num("menu", world?.InMenu ?? 0)</strong></article>
                <article class="fb-card fb-stat"><span class="fb-stat-label">In transit@(Tip("Survivors moving to a connected map with their gear."))</span><strong>@Num("transit", world?.InTransit ?? 0)</strong></article>
                <article class="fb-card fb-stat"><span class="fb-stat-label">Pending stories@(Tip("PMCs from your raids whose outcome is still to come."))</span><strong>@Num("stories", world?.PendingStories ?? 0)</strong></article>
            </div>

            <div class="fb-row fb-row-wide">
                <section class="fb-card fb-flush">
                    <div class="fb-card-head fb-padded"><div><h2>Maps</h2><p>Players per map over the last 90 minutes.</p></div></div>
                    <div class="fb-table-scroll">
                        <table class="fb-table">
                            <thead><tr><th>Map</th><th>In raid</th><th>Queueing</th><th>Avg queue</th><th>Share</th><th>Last 90 min</th></tr></thead>
                            <tbody>
                                @foreach (var map in maps)
                                {
                                    <tr @key="map.Id">
                                        <td><strong>@map.Name</strong>@if (map.WeeklyBoss) { <span class="fb-badge fb-badge-yellow fb-inline-badge">Weekly boss</span> }@if (map.Solo) { <span class="fb-badge fb-badge-green fb-inline-badge" title="Private instance, no random PMCs">Solo</span> }</td>
                                        <td>@Num("raid-" + map.Id, map.InRaid)</td><td>@Num("queue-" + map.Id, map.Queueing)</td><td>@Clock(map.QueueSeconds)</td>
                                        <td><span class="fb-signal" title="@((map.Share * 100).ToString("0.0"))% of players">@for (int bar = 0; bar < 4; bar++) { <span class="@(bar < Bars(map.Share) ? "fb-lit" : "")"></span> }</span></td>
                                        <td>@Sparkline(map.History)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Live activity</h2><p>What careers are doing, newest first.</p></div><span class="fb-live"><span></span>Live</span></div>
                    <ol class="fb-log">
                        @foreach (var item in (world?.Events ?? []).Take(25))
                        {
                            <li @key="item.Id" class="fb-log-@item.Kind"><span class="fb-log-dot"></span><span class="fb-log-text">@item.Text</span><time>@Ago(item.Utc)</time></li>
                        }
                    </ol>
                    @if (world?.Events.Count is null or 0) { <p class="fb-muted">Nothing yet. Careers come online over the next few minutes.</p> }
                </section>
            </div>
        }
        else if (page == "Players")
        {
            var rows = FilteredPlayers().ToList();
            int pages = Math.Max(1, (rows.Count + PageSize - 1) / PageSize);
            int current = Math.Clamp(playerPage, 0, pages - 1);
            <section class="fb-card">
                <div class="fb-toolbar fb-toolbar-wrap">
                    <label class="fb-field"><span class="fb-label">Search</span><input placeholder="Name" @bind="playerSearch" @bind:event="oninput" @bind:after="() => playerPage = 0" /></label>
                    <label class="fb-field"><span class="fb-label">Status</span><select @bind="playerFilter" @bind:after="() => playerPage = 0">
                        @foreach (var (value, label) in statusFilters) { <option value="@value">@label</option> }
                    </select></label>
                    <label class="fb-field"><span class="fb-label">Sort by</span><select @bind="playerSort">
                        @foreach (var option in sortOptions) { <option value="@option">@option</option> }
                    </select></label>
                    <button type="button" class="fb-button fb-button-light" @onclick="() => sortDescending = !sortDescending">@(sortDescending ? "Descending" : "Ascending")</button>
                </div>
            </section>
            <section class="fb-card fb-flush">
                <div class="fb-card-head fb-padded"><div><h2>@rows.Count.ToString("N0") players</h2><p>Updates every few seconds.</p></div>
                    <div class="fb-actions"><button type="button" class="fb-button fb-button-light" disabled="@(current == 0)" @onclick="() => playerPage = current - 1">Previous</button><span class="fb-muted fb-pager">@(current + 1) / @pages</span><button type="button" class="fb-button fb-button-light" disabled="@(current >= pages - 1)" @onclick="() => playerPage = current + 1">Next</button></div></div>
                <div class="fb-table-scroll">
                    <table class="fb-table">
                        <thead><tr><th>Name</th><th>Personality</th><th>Level</th><th title="Prestige">Prest.</th><th>Raids</th><th title="PMC kills per death">K/D</th><th>Status</th><th>For</th></tr></thead>
                        <tbody>
                            @foreach (var row in rows.Skip(current * PageSize).Take(PageSize))
                            {
                                <tr @key="row.Name + row.Side">
                                    <td><span class="fb-person"><span class="fb-avatar @(row.Side.Equals("Bear", StringComparison.OrdinalIgnoreCase) ? "fb-avatar-bear" : "fb-avatar-usec")">@row.Name[..1].ToUpperInvariant()</span><span><strong>@row.Name</strong><small>@row.Side.ToUpperInvariant()@(row.Notable ? " · streamer" : "")@if (row.Squad.Length > 0) { <span class="fb-squad" title="Squad with @string.Join(", ", row.Squad)">@Icon("Users") @(row.Squad.Length + 1)</span> }</small></span></span></td>
                                    <td>@row.Personality</td><td>@row.Level</td><td>@row.Prestige</td><td>@row.Raids.ToString("N0")</td><td>@row.KillDeath.ToString("0.00")</td>
                                    <td><span class="fb-state fb-state-@row.State.ToLowerInvariant()"><span class="fb-state-label">@StateLabel(row.State)</span>@if (row.Status.Length > 0) { <span class="fb-state-detail">@row.Status</span> }</span></td>
                                    <td class="fb-muted">@(row.Since > 0 ? Duration(row.Since) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else if (page == "Dashboard")
        {
            var insights = snapshot.Insights;
            int total = Math.Max(1, snapshot.Careers);
            <div class="fb-stats">
                <article class="fb-card fb-stat">
                    <span class="fb-stat-label">Accounts@(Tip("Persistent PMC careers, one per bot name."))</span><strong>@Num("careers", snapshot.Careers)</strong>
                    <span class="fb-stat-foot">@Icon("Users") Persistent identities</span>
                </article>
                <article class="fb-card fb-stat">
                    <span class="fb-stat-label">Simulated online@(Tip("Accounts playing right now. Each account comes online and logs off around its daily raid hours."))</span><strong>@Num("online-all", snapshot.Online)</strong>
                    <span class="fb-stat-foot"><span class="fb-up">@Percent(snapshot.Online, total)</span> of accounts</span>
                </article>
                <article class="fb-card fb-stat">
                    <span class="fb-stat-label">Prestiged@(Tip("Accounts that have prestiged at least once."))</span><strong>@Num("prestiged", snapshot.Prestiged)</strong>
                    <span class="fb-stat-foot"><span class="fb-up">@Percent(snapshot.Prestiged, total)</span> of accounts</span>
                </article>
                <article class="fb-card fb-stat">
                    <span class="fb-stat-label">Pending stories@(Tip("PMCs from your raids whose outcome (a later death, regear, transit or survival) is still to come."))</span><strong>@Num("stories-all", snapshot.PendingStories)</strong>
                    <span class="fb-stat-foot">@Icon("Clock") Outcomes awaiting resolution</span>
                </article>
            </div>

            <div class="fb-row fb-row-wide">
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Accounts by level</h2><p>Active careers in 10-level bands.</p></div><strong class="fb-figure">@insights.LevelBands.Sum().ToString("N0")</strong></div>
                    @{ int peak = Math.Max(1, insights.LevelBands.Max()); }
                    <div class="fb-bars" role="img" aria-label="Accounts by level band">
                        @for (int band = 0; band < insights.LevelBands.Length; band++)
                        {
                            int count = insights.LevelBands[band];
                            <div class="fb-bar" title="Level @(band * 10 + 1)-@(band == 7 ? 79 : band * 10 + 10): @count.ToString("N0") accounts">
                                <span class="fb-bar-value">@count.ToString("N0")</span>
                                <span class="fb-bar-fill" style="height:@((count * 100.0 / peak).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                <span class="fb-bar-label">@(band * 10 + 1)-@(band == 7 ? 79 : band * 10 + 10)</span>
                            </div>
                        }
                    </div>
                    <div class="fb-card-foot"><span>Level 1 to 79</span><button type="button" class="fb-link" @onclick="() => Go(simulationPages[0])">Progression settings @Icon("Chevron")</button></div>
                </section>
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Factions</h2><p>BEAR and USEC careers.</p></div></div>
                    @{ double bear = insights.Bear * 100.0 / Math.Max(1, insights.Bear + insights.Usec); }
                    <div class="fb-donut" style="--fb-share:@(bear.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" role="img" aria-label="@bear.ToString("0")% BEAR"><span><strong>@bear.ToString("0")%</strong><small>BEAR</small></span></div>
                    <ul class="fb-legend">
                        <li><span class="fb-swatch fb-swatch-primary"></span>BEAR<strong>@insights.Bear.ToString("N0")</strong></li>
                        <li><span class="fb-swatch fb-swatch-secondary"></span>USEC<strong>@insights.Usec.ToString("N0")</strong></li>
                    </ul>
                </section>
            </div>

            <div class="fb-row fb-row-wide">
                <section class="fb-card fb-flush">
                    <div class="fb-card-head fb-padded"><div><h2>Top careers</h2><p>Highest prestige, then highest level.</p></div></div>
                    <div class="fb-table-scroll">
                        <table class="fb-table">
                            <thead><tr><th>Name</th><th>Personality</th><th>Level</th><th title="Prestige">Prest.</th><th>Raids</th><th title="PMC kills per death">K/D</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var row in insights.TopCareers)
                                {
                                    <tr>
                                        <td><span class="fb-person"><span class="fb-avatar @(row.Side.Equals("Bear", StringComparison.OrdinalIgnoreCase) ? "fb-avatar-bear" : "fb-avatar-usec")">@row.Name[..1].ToUpperInvariant()</span><span><strong>@row.Name</strong><small>@row.Side.ToUpperInvariant()</small></span></span></td>
                                        <td>@row.Personality</td><td>@row.Level</td><td>@row.Prestige</td><td>@row.Raids.ToString("N0")</td><td>@row.KillDeath.ToString("0.00")</td>
                                        <td><span class="fb-status"><span class="fb-status-dot @(row.Online ? "fb-online" : "")"></span>@(row.Online ? "Online" : "Offline")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Personalities</h2><p>Share of active careers.</p></div></div>
                    @{ int careers = Math.Max(1, insights.Personalities.Values.Sum()); }
                    <ul class="fb-progress-list">
                        @foreach (var (name, count) in insights.Personalities)
                        {
                            <li><div><span>@name</span><span>@count.ToString("N0")</span></div><span class="fb-progress"><span style="width:@((count * 100.0 / careers).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span></li>
                        }
                    </ul>
                    <div class="fb-card-foot"><span>@insights.Personalities.Count personalities</span><button type="button" class="fb-link" @onclick='() => Go("Personalities")'>Edit @Icon("Chevron")</button></div>
                </section>
            </div>

            <div class="fb-row">
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Weapon racks</h2><p>Accounts with a built weapon rack that show at least one gun.</p></div><strong class="fb-figure">@Percent(insights.RacksFilled, Math.Max(1, insights.RackOwners))</strong></div>
                    <span class="fb-progress fb-progress-lg"><span style="width:@((insights.RacksFilled * 100.0 / Math.Max(1, insights.RackOwners)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                    <p class="fb-muted">@insights.RacksFilled.ToString("N0") of @insights.RackOwners.ToString("N0") racks filled. Empty racks fill when someone opens the profile.</p>
                </section>
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>APBS bridge</h2><p>@snapshot.GenerationMode</p></div></div>
                    <dl class="fb-dl"><div><dt>Career selections</dt><dd>@snapshot.ApbsMatched.ToString("N0")</dd></div><div><dt>Unmatched level ranges</dt><dd>@snapshot.ApbsFallback.ToString("N0")</dd></div></dl>
                    <p class="fb-muted">APBS supplies equipment and appearance. Careers keep their identity, history and friendships between raids.</p>
                </section>
            </div>
        }
        else if (page == "Personalities")
        {
            <section class="fb-card">
                <div class="fb-toolbar"><label class="fb-field">Selected personality<select @bind="selectedIndex">
                    @for (int index = 0; index < people.Count; index++) { <option value="@index">@people[index].Id</option> }
                </select></label><button type="button" class="fb-button fb-button-light" @onclick="Add">@Icon("Plus") Add personality</button></div>
            </section>
            @if (Current is { } p)
            {
                <section class="fb-card"><h2>Identity &amp; distribution</h2><div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Name@(Tip("Personality ID. Careers store this name, so renaming it moves existing careers to the first personality."))</span><input @bind="p.Id" /></label>
                    <label class="fb-field"><span class="fb-label">Population weight@(Tip("How often new accounts roll this personality, relative to the other weights."))</span><input type="number" min="1" max="1000" @bind="p.Weight" /></label>
                </div></section>
                <section class="fb-card"><h2>Starting experience</h2><p class="fb-muted">Ranges used when a new account is created. Raids, hours and kills are worked out from the level, so they always fit it.</p><div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Starting level, minimum@(Tip("Lowest level a new account of this personality starts at."))</span><input type="number" min="1" max="79" @bind="p.MinimumLevel" /></label>
                    <label class="fb-field"><span class="fb-label">Starting level, maximum@(Tip("Highest level a new account of this personality starts at."))</span><input type="number" min="1" max="79" @bind="p.MaximumLevel" /></label>
                </div></section>
                <section class="fb-card"><h2>Raid behavior</h2><p class="fb-muted">Hours are daily totals. Survival chances use 0 to 1 (0.5 = 50%).</p><div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Daily raid hours, minimum@(Tip("Least time per day this account plays. It also sets how often the account shows as online."))</span><input type="number" step="0.05" @bind="p.MinimumDailyHours" /></label>
                    <label class="fb-field"><span class="fb-label">Daily raid hours, maximum@(Tip("Most time per day this account plays. It also sets how often the account shows as online."))</span><input type="number" step="0.05" @bind="p.MaximumDailyHours" /></label>
                    <label class="fb-field"><span class="fb-label">Survival chance, minimum@(Tip("Survival chance (0 to 1) of the least skilled accounts. Skill also sets kills, so low survival means fewer kills."))</span><input type="number" min="0" max="1" step="0.01" @bind="p.MinimumSurvival" /></label>
                    <label class="fb-field"><span class="fb-label">Survival chance, maximum@(Tip("Survival chance (0 to 1) of the most skilled accounts."))</span><input type="number" min="0" max="1" step="0.01" @bind="p.MaximumSurvival" /></label>
                    <label class="fb-field"><span class="fb-label">Raid minutes, minimum@(Tip("Shortest simulated raid. Clamped to 3-60 minutes."))</span><input type="number" @bind="p.MinimumRaidMinutes" /></label>
                    <label class="fb-field"><span class="fb-label">Raid minutes, maximum@(Tip("Longest simulated raid. Clamped to 3-60 minutes."))</span><input type="number" @bind="p.MaximumRaidMinutes" /></label>
                </div></section>
                <section class="fb-card"><h2>Personality progression</h2><div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Progress to@(Tip("Personality this account turns into after enough raid hours, e.g. Timmy into Casual."))</span><select @bind="p.ProgressTo"><option value="">Stay this personality</option>
                        @foreach (var target in people.Where(t => t != p)) { <option value="@target.Id">@target.Id</option> }
                    </select></label>
                    <label class="fb-field"><span class="fb-label">Progress after account raid hours@(Tip("Total raid hours before the account switches to the Progress to personality."))</span><input type="number" @bind="p.TransitionHours" /></label>
                </div></section>
                <section class="fb-card fb-danger-zone"><h2>Remove personality</h2><p class="fb-muted">Removes @p.Id from this draft. Save personalities to apply the removal.</p><button type="button" class="fb-button fb-button-red" @onclick="Remove">Remove @p.Id</button></section>
            }
            <div class="fb-savebar"><span>Starting ranges apply to new accounts. Progression targets affect existing accounts.</span><button type="button" class="fb-button" disabled="@(!Dirty("personalities"))" @onclick="SavePeople">Save personalities</button></div>
        }
        else if (page == "Progression")
        {
            <section class="fb-card">
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.EnableApbsCareerIntegration" /><span class="fb-switch-track"></span>Select persistent careers within APBS level ranges@(Tip("When APBS spawns a PMC, reuse an existing career whose level fits APBS's level range, so you meet the same players again."))</label></div>
            </section>
            <section class="fb-card fb-flush"><div class="fb-card-head fb-padded"><div><h2>Raid history priors</h2><p>Bands must increase and end at level 79. These averages are priors, not identical targets for every account.</p></div></div>
                <div class="fb-table-scroll"><table class="fb-table"><thead><tr><th>Maximum level</th><th title="Average length of a raid the account survives.">Survived raid min</th><th title="Average length of a raid that ends in death.">Death raid min</th><th title="For an average-skill account. Skill and personality scale it.">PMC kills / raid</th><th title="For an average-skill account. Skill and personality scale it.">Scav kills / raid</th></tr></thead><tbody>
                    @foreach (var prior in simulation.ProgressionPriors)
                    {
                        var row = simulation.ProgressionPriors.IndexOf(prior) + 1;
                        <tr @key="prior"><td><input aria-label="Maximum level, band @row" type="number" min="1" max="79" @bind="prior.MaximumLevel" /></td>
                            <td><input aria-label="Survived raid minutes, band @row" type="number" min="3" max="60" step="0.5" @bind="prior.SurvivedMinutes" /></td>
                            <td><input aria-label="Death raid minutes, band @row" type="number" min="3" max="60" step="0.5" @bind="prior.DeathMinutes" /></td>
                            <td><input aria-label="PMC kills per raid, band @row" type="number" min="0" max="20" step="0.01" @bind="prior.PmcKills" /></td>
                            <td><input aria-label="Scav kills per raid, band @row" type="number" min="0" max="20" step="0.01" @bind="prior.ScavKills" /></td></tr>
                    }
                </tbody></table></div>
            </section>
            <section class="fb-card"><h2>Raid experience &amp; time</h2><p class="fb-muted">With the defaults an average account needs about 60 raids for level 15, 440 for level 40 and 3,800 for level 79.</p><div class="fb-grid">
                <label class="fb-field"><span class="fb-label">Survived raid XP, base@(Tip("XP for a survived raid at level 0. Raid XP decides how many raids an account needed to reach its level."))</span><input type="number" min="100" max="100000" step="100" @bind="simulation.RaidExperience.SurvivedBase" /></label>
                <label class="fb-field"><span class="fb-label">Survived raid XP, per level@(Tip("Extra survived raid XP per level."))</span><input type="number" min="0" max="10000" step="10" @bind="simulation.RaidExperience.SurvivedPerLevel" /></label>
                <label class="fb-field"><span class="fb-label">Survived raid XP, per level squared@(Tip("Extra survived raid XP per level squared, so high levels earn much more per raid."))</span><input type="number" min="0" max="1000" step="0.5" @bind="simulation.RaidExperience.SurvivedPerLevelSquared" /></label>
                <label class="fb-field"><span class="fb-label">Death XP share@(Tip("Share (0 to 1) of the survived XP a death still earns."))</span><input type="number" min="0" max="1" step="0.05" @bind="simulation.RaidExperience.DeathShare" /></label>
                <label class="fb-field"><span class="fb-label">Online time factor, minimum@(Tip("Online time is raid time times a factor between these two, for menus, hideout and flea."))</span><input type="number" min="1" max="5" step="0.05" @bind="simulation.OnlineTimeMinimum" /></label>
                <label class="fb-field"><span class="fb-label">Online time factor, maximum@(Tip("Upper end of the online time factor."))</span><input type="number" min="1" max="5" step="0.05" @bind="simulation.OnlineTimeMaximum" /></label>
            </div></section>
            <section class="fb-card"><h2>Achievements</h2><p class="fb-muted">Share of level 79, average-skill accounts that own a given achievement. Lower levels own fewer, skill scales it.</p><div class="fb-grid fb-grid-3">
                <label class="fb-field"><span class="fb-label">Common@(Tip("Share (0 to 1) of level 79, average-skill accounts that own a given Common achievement."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.Achievements.Common" /></label>
                <label class="fb-field"><span class="fb-label">Rare@(Tip("Same for Rare achievements, mostly boss kills."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.Achievements.Rare" /></label>
                <label class="fb-field"><span class="fb-label">Legendary@(Tip("Same for Legendary achievements, mostly events and Kappa."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.Achievements.Legendary" /></label>
            </div></section>
            @SimulationSave
        }
        else if (page == "Hideout")
        {
            <section class="fb-card"><h2>Construction</h2><p class="fb-muted">Season cohort observations guide module preferences. Time, wealth, personality and native prerequisites still decide upgrades. Existing construction is never downgraded.</p><div class="fb-grid">
                <label class="fb-field"><span class="fb-label">Construction speed@(Tip("How fast simulated accounts build hideout modules. 1 is normal, 2 is twice as fast."))</span><input type="number" min="0.25" max="4" step="0.05" @bind="simulation.Hideout.ConstructionSpeed" /></label>
                <label class="fb-field"><span class="fb-label">Material cost multiplier@(Tip("How much simulated hideout upgrades cost the account. Higher means slower upgrades."))</span><input type="number" min="0.25" max="4" step="0.05" @bind="simulation.Hideout.MaterialCostMultiplier" /></label>
                <label class="fb-field"><span class="fb-label">Built chance multiplier@(Tip("Scales how likely each hideout module is to be built at all for an account's level."))</span><input type="number" min="0.25" max="4" step="0.05" @bind="simulation.Hideout.BuiltChanceMultiplier" /></label>
                <label class="fb-field"><span class="fb-label">Hideout neglecters@(Tip("Share of accounts that mostly ignore the hideout: few modules, none past level 1, whatever their level."))</span><input type="number" min="0" max="0.5" step="0.01" @bind="simulation.Hideout.NeglectedShare" /></label>
            </div><p class="fb-hint">Speed and cost default to 1, built chance to 2. Edition starting privileges remain. Seasonal events and emergency-wall history are not fabricated.</p></section>
            @SimulationSave
        }
        else if (page == "Gear")
        {
            <section class="fb-card"><h2>Loadouts</h2><p class="fb-muted">APBS builds every loadout. These control which kit it builds and where it is used.</p>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.RetainProfileGearInRaid" /><span class="fb-switch-track"></span>Careers wear their profile loadout in raid@(Tip("When a career spawns in raid, it wears the loadout its profile shows, plus fresh APBS loot. Off means APBS rolls a new kit for each spawn."))</label></div>
                <div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Night kit chance@(Tip("Share (0 to 1) of generated profile loadouts built as night raid kits, which can carry NVGs."))</span><input type="number" min="0" max="1" step="0.05" @bind="simulation.NightGearChance" /></label>
                </div>
            </section>
            <section class="fb-card"><h2>Showcases</h2><p class="fb-muted">Only accounts that built the weapon rack or trophy stand get a showcase. Favorites stay pinned until an item becomes unavailable.</p>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.EnableShowcase" /><span class="fb-switch-track"></span>Hideout-gated showcases@(Tip("Fill weapon racks and trophy stands, only for accounts that have built those hideout modules."))</label></div>
                <div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Rack gun tier boost, minimum@(Tip("Fewest APBS gear tiers above the account's own that rack guns are built at. Capped at APBS's top tier."))</span><input type="number" min="0" max="6" @bind="simulation.RackTierBoostMinimum" /></label>
                    <label class="fb-field"><span class="fb-label">Rack gun tier boost, maximum@(Tip("Most APBS gear tiers above the account's own that rack guns are built at. Each rack loadout rolls in this range."))</span><input type="number" min="0" max="6" @bind="simulation.RackTierBoostMaximum" /></label>
                </div>
            </section>
            @SimulationSave
        }
        else if (page == "Notable")
        {
            <section class="fb-card"><h2>Chads and streamers</h2><p class="fb-muted">Accounts with "chad" in the name or a TTV, YT or TV tag are better players and always wear gear above their level's tier, in raid and on their profile.</p>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.NotableNames.Enabled" /><span class="fb-switch-track"></span>Boost chads and streamers@(Tip("Give chad and streamer names better stats and gear."))</label></div>
                <div class="fb-grid fb-grid-3">
                    <label class="fb-field"><span class="fb-label">Skill bonus@(Tip("How far their hidden skill roll moves towards the best player. 0.3 closes 30% of the gap, which raises survival, kills and K/D."))</span><input type="number" min="0" max="1" step="0.05" @bind="simulation.NotableNames.SkillBonus" /></label>
                    <label class="fb-field"><span class="fb-label">Gear tier boost, minimum@(Tip("Fewest APBS gear tiers they skip ahead of their level."))</span><input type="number" min="0" max="6" @bind="simulation.NotableNames.TierBoostMinimum" /></label>
                    <label class="fb-field"><span class="fb-label">Gear tier boost, maximum@(Tip("Most APBS gear tiers they skip ahead of their level. Each account rolls once in this range and keeps it."))</span><input type="number" min="0" max="6" @bind="simulation.NotableNames.TierBoostMaximum" /></label>
                </div>
            </section>
            @SimulationSave
        }
        else if (page == "Prestige")
        {
            <section class="fb-card"><h2>Prestige</h2><p class="fb-muted">Prestige follows the installed requirements and fictional quest histories. Lifetime history and account registration persist.</p>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.EnablePrestige" /><span class="fb-switch-track"></span>Prestige progression@(Tip("Let simulated accounts prestige when they meet the installed prestige requirements."))</label></div>
                <div class="fb-grid fb-grid-3">
                    <label class="fb-field"><span class="fb-label">Minimum raid hours per cycle@(Tip("Raid hours an account needs since its last prestige before it can prestige again."))</span><input type="number" min="10" max="10000" @bind="simulation.MinimumPrestigeCycleHours" /></label>
                    <label class="fb-field"><span class="fb-label">Starting prestige share@(Tip("Share of new accounts (not Timmies) that start with at least one prestige behind them, at any current level."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.InitialPrestige.Share" /></label>
                    <label class="fb-field"><span class="fb-label">Further prestige chance@(Tip("Chance of each further starting prestige. 0.45 means about 45% of prestiged accounts have 2 or more, and 20% have 3 or more."))</span><input type="number" min="0" max="0.95" step="0.05" @bind="simulation.InitialPrestige.Repeat" /></label>
                </div>
            </section>
            @SimulationSave
        }
        else if (page == "Stories")
        {
            <section class="fb-card"><h2>Post-raid stories</h2><p class="fb-muted">Every career from your raid that did not die in front of you gets a delayed outcome: it dies, regears, transits or survives. Your killer and the rest of the raid have their own chances, and personality shifts both. Outcomes never rewrite the equipment you saw.</p>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.EnablePostRaidStories" /><span class="fb-switch-track"></span>Enable post-raid stories@(Tip("PMCs from your raid may later die, regear or transit, so their profiles change between raids."))</label></div>
                <div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Your killer, death chance@(Tip("Chance (0 to 1) that a PMC who killed you dies later."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.PostRaidDeathChance" /></label>
                    <label class="fb-field"><span class="fb-label">Your killer, regear chance@(Tip("Chance (0 to 1) that a PMC who killed you swaps to new gear later."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.PostRaidRegearChance" /></label>
                    <label class="fb-field"><span class="fb-label">Other PMCs, death chance@(Tip("Chance (0 to 1) that any other PMC from your raid dies later. Keep it low, a raid can hold a dozen."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.RaidDeathChance" /></label>
                    <label class="fb-field"><span class="fb-label">Other PMCs, regear chance@(Tip("Chance (0 to 1) that any other PMC from your raid swaps to new gear later."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.RaidRegearChance" /></label>
                    <label class="fb-field"><span class="fb-label">Delay, minimum seconds@(Tip("Earliest time after your death that a story outcome can happen."))</span><input type="number" min="30" max="86400" @bind="simulation.StoryMinimumDelaySeconds" /></label>
                    <label class="fb-field"><span class="fb-label">Delay, maximum seconds@(Tip("Latest time after your death that a story outcome can happen."))</span><input type="number" min="30" max="86400" @bind="simulation.StoryMaximumDelaySeconds" /></label>
                    <label class="fb-field"><span class="fb-label">Outcome visibility, seconds@(Tip("How long a story outcome stays visible before the account carries on normally."))</span><input type="number" min="60" max="86400" @bind="simulation.StoryVisibilitySeconds" /></label>
                </div><p class="fb-hint">Each death and regear pair cannot exceed 1. Otherwise the PMC keeps its kit.</p>
            </section>
            @SimulationSave
        }
        else if (page == "World")
        {
            <section class="fb-card"><h2>Maps and queues</h2><p class="fb-muted">Online careers queue for a map, play a raid, extract, die or transit, then queue again or log off. Busy maps fill faster. Raid time is earned raid by raid, so profiles match what the maps show.</p><div class="fb-grid fb-grid-3">
                <label class="fb-field"><span class="fb-label">Weekly boss boost@(Tip("Popularity of a map whose headline boss is guaranteed. Weekly boss rotations set one boss to 100%, so its map gets busier."))</span><input type="number" min="1" max="5" step="0.1" @bind="simulation.World.WeeklyBossBoost" /></label>
                <label class="fb-field"><span class="fb-label">Streamer map boost@(Tip("How much more streamers and chads play Labs, Streets and Customs, and how much more often they spawn in your raids there."))</span><input type="number" min="1" max="10" step="0.1" @bind="simulation.World.StreamerMapBoost" /></label>
                <label class="fb-field"><span class="fb-label">Queue time multiplier@(Tip("Scales every simulated queue time. 2 doubles them."))</span><input type="number" min="0.1" max="10" step="0.1" @bind="simulation.World.QueueTimeMultiplier" /></label>
                <label class="fb-field"><span class="fb-label">Transit chance@(Tip("Chance (0 to 1) that a survivor moves on to a connected map with its gear, in the world and after your raids."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.World.TransitChance" /></label>
                <label class="fb-field"><span class="fb-label">Log off after a raid@(Tip("Chance (0 to 1) that a career logs off after a raid instead of queueing again. Deaths log off a bit more often."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.World.LogOffChance" /></label>
            </div></section>
            <section class="fb-card"><h2>Matching screen</h2><p class="fb-muted">Before a raid the loading screen shows Matching with a timer, then Looking for server (5-15 s), Preparing the game and Awaiting response. Not used with Fika or on transits.</p>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.World.SimulateMatching" /><span class="fb-switch-track"></span>Simulate matching@(Tip("Wait for a match based on the map's simulated queue before the raid starts."))</label></div>
                <div class="fb-grid fb-grid-3">
                    <label class="fb-field"><span class="fb-label">Longest matching, seconds@(Tip("Cap on the Matching stage. Looking for server still adds 5-15 seconds."))</span><input type="number" min="0" max="600" @bind="simulation.World.MaximumMatchingSeconds" /></label>
                </div>
            </section>
            @SimulationSave
        }
        else if (page == "Messages")
        {
            <section class="fb-card"><h2>Bot messages</h2><p class="fb-muted">Careers you kill, or that kill you, can message you after the raid. They only speak up after something notable: a squad wipe, a long shot, a kill at an exit or on a full bag, a boss raid, a rampage cut short, an underdog win or an expensive kit. Their tone follows the personality, and streamers talk to their chat.</p>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.BotMessages.Enabled" /><span class="fb-switch-track"></span>Send career messages@(Tip("Let careers message you after notable raid events."))</label></div>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="simulation.BotMessages.ReplaceNativeMessages" /><span class="fb-switch-track"></span>Silence SPT's own PMC messages@(Tip("Careers never send SPT's built-in victim and killer messages."))</label></div>
                <div class="fb-grid fb-grid-3">
                    <label class="fb-field"><span class="fb-label">Chance per notable event@(Tip("Chance (0 to 1) that a notable event gets a message. A squad wipe counts three times. At most one message per raid."))</span><input type="number" min="0" max="1" step="0.01" @bind="simulation.BotMessages.Chance" /></label>
                    <label class="fb-field"><span class="fb-label">Delay, minimum seconds@(Tip("Earliest time after the raid that a message arrives."))</span><input type="number" min="0" max="3600" @bind="simulation.BotMessages.MinimumDelaySeconds" /></label>
                    <label class="fb-field"><span class="fb-label">Delay, maximum seconds@(Tip("Latest time after the raid that a message arrives."))</span><input type="number" min="0" max="3600" @bind="simulation.BotMessages.MaximumDelaySeconds" /></label>
                </div>
            </section>
            @SimulationSave
        }
        else
        {
            <section class="fb-card"><h2>Friendships</h2>
                <div class="fb-switch-row"><label class="fb-switch"><input type="checkbox" role="switch" @bind="config.EnableFriendRequests" /><span class="fb-switch-track"></span>Bot friend requests@(Tip("Allow sending friend requests to simulated accounts."))</label></div>
                <div class="fb-grid">
                    <label class="fb-field"><span class="fb-label">Friend acceptance chance@(Tip("Chance (0 to 1) that a simulated account accepts your friend request."))</span><input type="number" min="0" max="1" step="0.01" @bind="config.FriendAcceptanceChance" /></label>
                    <label class="fb-field"><span class="fb-label">Friend activity multiplier@(Tip("Accepted friends play and show online this many times as often as other accounts."))</span><input type="number" min="0" max="5" step="0.1" @bind="config.FriendActivityMultiplier" /></label>
                </div><p class="fb-hint">Disabling new friend requests keeps existing accepted friendships.</p>
            </section>
            <section class="fb-card"><h2>Activity</h2><div class="fb-grid fb-grid-3">
                <label class="fb-field"><span class="fb-label">Online rate multiplier@(Tip("Scales how often every account is online. 1 is the default, 2 doubles it."))</span><input type="number" min="0" max="10" step="0.1" @bind="config.OnlineRateMultiplier" /></label>
                <label class="fb-field"><span class="fb-label">Offline progression threshold, seconds@(Tip("Minimum server downtime before accounts get simulated progress for the time you were away."))</span><input type="number" min="60" max="86400" @bind="config.ProgressionThresholdSeconds" /></label>
                <label class="fb-field"><span class="fb-label">Maximum offline days@(Tip("Cap on how many offline days of progress are simulated at server start."))</span><input type="number" min="1" max="365" @bind="config.MaximumOfflineDays" /></label>
            </div></section>
            <div class="fb-savebar"><span>Existing identities and accepted friends remain.</span><button type="button" class="fb-button" disabled="@(!Dirty("settings"))" @onclick="SaveConfig">Save population settings</button></div>
        }
    </main>
</div>

@code {
    private static readonly string[] topPages = ["Overview", "Dashboard", "Players", "Personalities", "Simulation", "Population"];
    private static readonly string[] simulationPages = ["Progression", "Hideout", "Gear", "Notable", "Prestige", "Stories", "Messages", "World"];
    private static readonly (string Value, string Label)[] statusFilters =
        [("", "Everyone"), ("Online", "Online"), ("Raid", "In raid"), ("Queue", "Queueing"), ("Menu", "Main menu"), ("Afk", "AFK"), ("Transit", "In transit"), ("Died", "Died"), ("Offline", "Offline"), ("Squad", "In a squad")];
    private static readonly string[] sortOptions = ["Status", "Name", "Level", "Prestige", "Raids", "K/D"];
    private const int PageSize = 50;
    private EditorSnapshot? snapshot;
    private WorldSnapshot? world;
    private List<WorldPlayerRow> players = new();
    private List<PersonalityTemplate> people = new();
    private SimulationPolicy simulation = new();
    private PbtSettings config = new();
    private readonly Dictionary<string, string> baselines = new();
    private readonly Dictionary<string, double> shownNumbers = new(), targetNumbers = new();
    private string page = "Overview", message = "", playerSearch = "", playerFilter = "", playerSort = "Status";
    private int selectedIndex, slide, playerPage, ticks;
    private bool error, confirmReload, dark = true, menuOpen, simulationOpen = true, sortDescending, animating;
    private System.Threading.Timer? live;

    private RenderFragment SimulationSave => @<div class="fb-savebar"><span>Saves every Simulation page at once.</span><button type="button" class="fb-button" disabled="@(!Dirty("simulation"))" @onclick="SavePolicy">Save simulation policy</button></div>;

    private static string Title(string page) => page switch {
        "Gear" => "Gear & showcases", "Notable" => "Chads & streamers", "Stories" => "Post-raid stories", "Messages" => "Bot messages", "Players" => "All players", "World" => "Maps & matching", _ => page };
    private static string Heading(string page) => page switch {
        "Overview" => "Live world", "Dashboard" => "Population dashboard", "Population" => "Population settings", _ => Title(page) };
    private static string Description(string page) => page switch {
        "Overview" => "Who's online, where they're playing and what just happened. Updates live.",
        "Dashboard" => "A snapshot of your server's persistent population.",
        "Players" => "Every career: what it's doing right now, who it plays with and how it has done.",
        "World" => "Map popularity, queues, transits and the matching screen.",
        "Personalities" => "Starting ranges and progression targets. Edits affect future simulation without rerolling existing accounts.",
        "Progression" => "Level cohorts guide varied account histories. Native requirements remain in force.",
        "Hideout" => "How simulated accounts build and upgrade their hideout.",
        "Gear" => "Profile loadouts, night kits and weapon racks.",
        "Notable" => "Better stats and gear for chad and streamer names.",
        "Prestige" => "When simulated accounts prestige, and how many start prestiged.",
        "Stories" => "What happens to the PMCs from your raid after it ends.",
        "Messages" => "Rare post-raid messages from careers you met.",
        _ => "Friendships and activity between server sessions." };
    private static string? Section(string page) => page switch {
        "Personalities" => "personalities", "Population" => "settings", "Dashboard" or "Overview" or "Players" => null, _ => "simulation" };
    // preventDefault keeps a click on the icon from toggling or focusing the label's control.
