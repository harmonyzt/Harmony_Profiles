            <section class="fb-card fb-flush">
                <div class="fb-card-head fb-padded"><div><h2>Presets</h2><p>A preset holds personalities, simulation and population settings. Share one by dropping its .json file in the mod's Presets folder.</p></div>
                    <div class="fb-actions"><button type="button" class="fb-button fb-button-light" title="@presetFolder" @onclick="OpenPresetFolder">Open presets folder</button><button type="button" class="fb-button fb-button-light" @onclick="LoadPresets">@Icon("Reload") Refresh</button></div></div>
                <div class="fb-table-scroll">
                    <table class="fb-table">
                        <thead><tr><th>Name</th><th>Status</th><th></th></tr></thead>
