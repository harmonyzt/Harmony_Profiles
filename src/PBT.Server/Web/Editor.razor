    private void LoadProfile()
    {
        try { profile = Store.GetPlayerProfile(playerId); } catch { profile = null; }
    }
    private void AddStreamer()
    {
        var (ok, restart, text) = Store.CheckStreamerName(streamerName, streamerSide);
        if (ok)
        {
            string name = streamerName.Trim();
            if (!simulation.NotableNames.ExtraNames.Contains(name, StringComparer.OrdinalIgnoreCase)) simulation.NotableNames.ExtraNames.Add(name);
            streamerName = "";
        }
        Notify(!ok, text);
        // A restart warning stays up longer than a plain success.
        if (ok && restart) { noticeTimer?.Cancel(); error = false; message = text; }
    }

    private RenderFragment SimulationSave => @<div class="fb-savebar"><span>Saves every Simulation page at once.</span><button type="button" class="fb-button" disabled="@(!Dirty("simulation"))" @onclick="SavePolicy">Save simulation policy</button></div>;

