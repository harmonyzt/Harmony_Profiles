                                <button type="button" class="fb-name-link" @onclick="() => OpenPlayer(row.CareerId)">@row.Name</button>
                                <span class="fb-muted">@row.Side, level @row.Level</span>
                            </td>
                            <td>
                                <span class="fb-badge @(row.State switch { "Spawned" => "fb-badge-green", "Banned" or "Died" => "fb-badge-red", "Extracted" => "fb-badge-yellow", _ => "" })"
                                      title="@(row.SpawnedUtc > 0 ? "Spawned " + Ago(row.SpawnedUtc) : "Generated for the raid, not spawned (yet)")">
                                    @(row.State == "Generated" ? "Not spawned" : row.State)
                                </span>
                            </td>
                            <td>@(row.Debug ? "Debug pick" : row.Style)</td>
                            <td><strong>@row.Type</strong></td>
                            <td class="fb-cheat-list">
                                @if (row.Cheats.Count == 0)
                                {
                                    <span class="fb-muted">None</span>
                                }
                                @foreach (var cheat in row.Cheats)
                                {
                                    <span class="fb-badge">@CheaterRules.CheatLabels.GetValueOrDefault(cheat, cheat)</span>
                                }
                            </td>
                            <td>@(row.Cheats.Contains("Vacuum") ? row.Looted.ToString() : "")</td>
