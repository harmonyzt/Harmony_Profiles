@page "/pbt"
@namespace PBT.Server.Web
@using PBT.Server
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@layout SPTarkov.Server.Web.Layout.BaseMainLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@rendermode InteractiveServer

<PageTitle>PBT - Progressive Bot Profiles</PageTitle>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="/pbt-assets/pbt.css?v=20261029-fb" rel="stylesheet" />
<div class="pbt-editor" data-theme="@(dark ? "dark" : "light")">
    <nav class="fb-topbar">
        <button type="button" class="fb-icon-button fb-menu" aria-label="Toggle navigation" aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => menuOpen = !menuOpen">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
        </button>
        <span class="fb-brand"><span class="fb-logo" aria-hidden="true">P</span><span>PBT</span><small>Progressive Bot Profiles</small></span>
        <span class="fb-spacer"></span>
        <span class="fb-pill @(snapshot is null ? "fb-pill-red" : "fb-pill-green")"><span class="fb-pill-dot" aria-hidden="true"></span>@(snapshot is null ? "Settings unavailable" : "Server ready")</span>
        <button type="button" class="fb-icon-button" title="@(dark ? "Switch to light mode" : "Switch to dark mode")" aria-label="Toggle dark mode" @onclick="() => dark = !dark">
            @if (dark)
            {
                <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.5" /><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4" /></svg>
            }
            else
            {
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 12.5A7 7 0 0 1 7.5 4a7 7 0 1 0 8.5 8.5Z" /></svg>
            }
        </button>
    </nav>

    <aside class="fb-sidebar @(menuOpen ? "fb-open" : "")" aria-label="PBT sections">
        <ul class="fb-nav">
            @foreach (var item in topPages)
            {
                @if (item == "Simulation")
                {
                    <li>
                        <button type="button" class="fb-nav-item @(simulationPages.Contains(page) ? "fb-parent-active" : "")" aria-expanded="@(simulationOpen ? "true" : "false")" @onclick="() => simulationOpen = !simulationOpen">
                            @Icon("Simulation")<span class="fb-nav-label">Simulation</span>
                            @if (Dirty("simulation")) { <span class="fb-dot" aria-hidden="true"></span><span class="fb-sr-only">, unsaved changes</span> }
                            <svg class="fb-chevron @(simulationOpen ? "fb-rotated" : "")" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4" /></svg>
                        </button>
                        @if (simulationOpen)
                        {
                            <ul class="fb-subnav">
                                @foreach (var sub in simulationPages)
                                {
                                    <li><button type="button" class="fb-nav-item @(page == sub ? "fb-active" : "")" aria-current="@(page == sub ? "page" : null)" @onclick="() => Go(sub)">@Title(sub)</button></li>
                                }
                            </ul>
                        }
                    </li>
                }
                else
                {
                    <li>
                        <button type="button" class="fb-nav-item @(page == item ? "fb-active" : "")" aria-current="@(page == item ? "page" : null)" @onclick="() => Go(item)">
                            @Icon(item)<span class="fb-nav-label">@Title(item)</span>
                            @if (PageDirty(item)) { <span class="fb-dot" aria-hidden="true"></span><span class="fb-sr-only">, unsaved changes</span> }
                        </button>
                    </li>
                }
            }
        </ul>
        <ul class="fb-nav fb-nav-secondary">
            <li><a class="fb-nav-item" href="https://github.com/harmonyzt/Harmony_Profiles" target="_blank" rel="noopener">@Icon("GitHub")<span class="fb-nav-label">GitHub repository</span></a></li>
            <li><button type="button" class="fb-nav-item" @onclick="RequestReload">@Icon("Reload")<span class="fb-nav-label">Reload saved settings</span></button></li>
        </ul>
    </aside>
    @if (menuOpen) { <div class="fb-backdrop" @onclick="() => menuOpen = false"></div> }

    <main class="fb-content">
        <ol class="fb-breadcrumb" aria-label="Breadcrumb">
            <li>@Icon("Home")PBT</li>
            @if (simulationPages.Contains(page)) { <li>Simulation</li> }
            <li aria-current="page">@Title(page)</li>
        </ol>
        <div class="fb-page-heading">
            <div><h1>@Heading(page)</h1><p>@Description(page)</p></div>
            @if (page == "Dashboard" && snapshot is not null)
            {
                <button type="button" class="fb-button fb-button-light" @onclick="RefreshStatus">@Icon("Reload") Refresh status</button>
            }
            else if (Section(page) is { } section)
            {
                <span class="fb-badge @(Dirty(section) ? "fb-badge-yellow" : "fb-badge-green")">@(Dirty(section) ? "Unsaved changes" : "Saved")</span>
            }
        </div>

        @if (confirmReload)
        {
            <div class="fb-alert fb-alert-yellow" role="alertdialog" aria-label="Discard unsaved settings">
                <div><strong>Discard unsaved changes?</strong> Every section with edits goes back to the saved settings.</div>
                <div class="fb-actions"><button type="button" class="fb-button fb-button-red" @onclick="Reload">Discard and reload</button><button type="button" class="fb-button fb-button-light" @onclick="() => confirmReload = false">Keep editing</button></div>
            </div>
        }
        @if (!string.IsNullOrEmpty(message))
        {
            <div role="status" aria-live="polite" class="fb-alert @(error ? "fb-alert-red" : "fb-alert-green")">@message</div>
        }

        @if (snapshot is null)
        {
            <section class="fb-card fb-empty"><h2>Settings are unavailable</h2><p>The population store could not be loaded. Try again when the server is ready.</p><button type="button" class="fb-button" @onclick="Reload">Try again</button></section>
        }
        else if (page == "Dashboard")
        {
            var insights = snapshot.Insights;
            int total = Math.Max(1, snapshot.Careers);
            <div class="fb-stats">
                <article class="fb-card fb-stat" title="Persistent PMC careers, one per bot name.">
                    <span class="fb-stat-label">Accounts</span><strong>@snapshot.Careers.ToString("N0")</strong>
                    <span class="fb-stat-foot">@Icon("Users") Persistent identities</span>
                </article>
                <article class="fb-card fb-stat" title="Accounts currently marked online. Re-rolled for each account every 10-30 minutes from its daily raid hours.">
                    <span class="fb-stat-label">Simulated online</span><strong>@snapshot.Online.ToString("N0")</strong>
                    <span class="fb-stat-foot"><span class="fb-up">@Percent(snapshot.Online, total)</span> of accounts</span>
                </article>
                <article class="fb-card fb-stat" title="Accounts that have prestiged at least once.">
                    <span class="fb-stat-label">Prestiged</span><strong>@snapshot.Prestiged.ToString("N0")</strong>
                    <span class="fb-stat-foot"><span class="fb-up">@Percent(snapshot.Prestiged, total)</span> of accounts</span>
                </article>
                <article class="fb-card fb-stat" title="Killer stories waiting to resolve (a later death or regear).">
                    <span class="fb-stat-label">Pending stories</span><strong>@snapshot.PendingStories.ToString("N0")</strong>
                    <span class="fb-stat-foot">@Icon("Clock") Outcomes awaiting resolution</span>
                </article>
            </div>

            <div class="fb-row fb-row-wide">
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Accounts by level</h2><p>Active careers in 10-level bands.</p></div><strong class="fb-figure">@insights.LevelBands.Sum().ToString("N0")</strong></div>
                    @{ int peak = Math.Max(1, insights.LevelBands.Max()); }
                    <div class="fb-bars" role="img" aria-label="Accounts by level band">
                        @for (int band = 0; band < insights.LevelBands.Length; band++)
                        {
                            int count = insights.LevelBands[band];
                            <div class="fb-bar" title="Level @(band * 10 + 1)-@(band == 7 ? 79 : band * 10 + 10): @count.ToString("N0") accounts">
                                <span class="fb-bar-value">@count.ToString("N0")</span>
                                <span class="fb-bar-fill" style="height:@((count * 100.0 / peak).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                <span class="fb-bar-label">@(band * 10 + 1)-@(band == 7 ? 79 : band * 10 + 10)</span>
                            </div>
                        }
                    </div>
                    <div class="fb-card-foot"><span>Level 1 to 79</span><button type="button" class="fb-link" @onclick="() => Go(simulationPages[0])">Progression settings @Icon("Chevron")</button></div>
                </section>
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Factions</h2><p>BEAR and USEC careers.</p></div></div>
                    @{ double bear = insights.Bear * 100.0 / Math.Max(1, insights.Bear + insights.Usec); }
                    <div class="fb-donut" style="--fb-share:@(bear.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" role="img" aria-label="@bear.ToString("0")% BEAR"><span><strong>@bear.ToString("0")%</strong><small>BEAR</small></span></div>
                    <ul class="fb-legend">
                        <li><span class="fb-swatch fb-swatch-primary"></span>BEAR<strong>@insights.Bear.ToString("N0")</strong></li>
                        <li><span class="fb-swatch fb-swatch-secondary"></span>USEC<strong>@insights.Usec.ToString("N0")</strong></li>
                    </ul>
                </section>
            </div>

            <div class="fb-row fb-row-wide">
                <section class="fb-card fb-flush">
                    <div class="fb-card-head fb-padded"><div><h2>Top careers</h2><p>Highest prestige, then highest level.</p></div></div>
                    <div class="fb-table-scroll">
                        <table class="fb-table">
                            <thead><tr><th>Name</th><th>Personality</th><th>Level</th><th title="Prestige">Prest.</th><th>Raids</th><th title="PMC kills per death">K/D</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var row in insights.TopCareers)
                                {
                                    <tr>
                                        <td><span class="fb-person"><span class="fb-avatar @(row.Side.Equals("Bear", StringComparison.OrdinalIgnoreCase) ? "fb-avatar-bear" : "fb-avatar-usec")">@row.Name[..1].ToUpperInvariant()</span><span><strong>@row.Name</strong><small>@row.Side.ToUpperInvariant()</small></span></span></td>
                                        <td>@row.Personality</td><td>@row.Level</td><td>@row.Prestige</td><td>@row.Raids.ToString("N0")</td><td>@row.KillDeath.ToString("0.00")</td>
                                        <td><span class="fb-status"><span class="fb-status-dot @(row.Online ? "fb-online" : "")"></span>@(row.Online ? "Online" : "Offline")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Personalities</h2><p>Share of active careers.</p></div></div>
                    @{ int careers = Math.Max(1, insights.Personalities.Values.Sum()); }
                    <ul class="fb-progress-list">
                        @foreach (var (name, count) in insights.Personalities)
                        {
                            <li><div><span>@name</span><span>@count.ToString("N0")</span></div><span class="fb-progress"><span style="width:@((count * 100.0 / careers).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span></li>
                        }
                    </ul>
                    <div class="fb-card-foot"><span>@insights.Personalities.Count personalities</span><button type="button" class="fb-link" @onclick='() => Go("Personalities")'>Edit @Icon("Chevron")</button></div>
                </section>
            </div>

            <div class="fb-row">
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>Weapon racks</h2><p>Accounts with a built weapon rack that show at least one gun.</p></div><strong class="fb-figure">@Percent(insights.RacksFilled, Math.Max(1, insights.RackOwners))</strong></div>
                    <span class="fb-progress fb-progress-lg"><span style="width:@((insights.RacksFilled * 100.0 / Math.Max(1, insights.RackOwners)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                    <p class="fb-muted">@insights.RacksFilled.ToString("N0") of @insights.RackOwners.ToString("N0") racks filled. Empty racks fill when someone opens the profile.</p>
                </section>
                <section class="fb-card">
                    <div class="fb-card-head"><div><h2>APBS bridge</h2><p>@snapshot.GenerationMode</p></div></div>
                    <dl class="fb-dl"><div><dt>Career selections</dt><dd>@snapshot.ApbsMatched.ToString("N0")</dd></div><div><dt>Unmatched level ranges</dt><dd>@snapshot.ApbsFallback.ToString("N0")</dd></div></dl>
                    <p class="fb-muted">APBS supplies equipment and appearance. Careers keep their identity, history and friendships between raids.</p>
                </section>
            </div>
        }
        else if (page == "Personalities")
        {
            <section class="fb-card">
                <div class="fb-toolbar"><label class="fb-field">Selected personality<select @bind="selectedIndex">
                    @for (int index = 0; index < people.Count; index++) { <option value="@index">@people[index].Id</option> }
                </select></label><button type="button" class="fb-button fb-button-light" @onclick="Add">@Icon("Plus") Add personality</button></div>
            </section>
            @if (Current is { } p)
            {
                <section class="fb-card"><h2>Identity &amp; distribution</h2><div class="fb-grid">
                    <label class="fb-field" title="Personality ID. Careers store this name, so renaming it moves existing careers to the first personality.">Name<input @bind="p.Id" /></label>
                    <label class="fb-field" title="How often new accounts roll this personality, relative to the other weights.">Population weight<input type="number" min="1" max="1000" @bind="p.Weight" /></label>
                </div></section>
                <section class="fb-card"><h2>Starting experience</h2><p class="fb-muted">Ranges used when a new account is created. Raids, hours and kills are worked out from the level, so they always fit it.</p><div class="fb-grid">
                    <label class="fb-field" title="Lowest level a new account of this personality starts at.">Starting level, minimum<input type="number" min="1" max="79" @bind="p.MinimumLevel" /></label>
                    <label class="fb-field" title="Highest level a new account of this personality starts at.">Starting level, maximum<input type="number" min="1" max="79" @bind="p.MaximumLevel" /></label>
                </div></section>
                <section class="fb-card"><h2>Raid behavior</h2><p class="fb-muted">Hours are daily totals. Survival chances use 0 to 1 (0.5 = 50%).</p><div class="fb-grid">
                    <label class="fb-field" title="Least time per day this account plays. It also sets how often the account shows as online.">Daily raid hours, minimum<input type="number" step="0.05" @bind="p.MinimumDailyHours" /></label>
                    <label class="fb-field" title="Most time per day this account plays. It also sets how often the account shows as online.">Daily raid hours, maximum<input type="number" step="0.05" @bind="p.MaximumDailyHours" /></label>
                    <label class="fb-field" title="Survival chance (0 to 1) of the least skilled accounts. Skill also sets kills, so low survival means fewer kills.">Survival chance, minimum<input type="number" min="0" max="1" step="0.01" @bind="p.MinimumSurvival" /></label>
                    <label class="fb-field" title="Survival chance (0 to 1) of the most skilled accounts.">Survival chance, maximum<input type="number" min="0" max="1" step="0.01" @bind="p.MaximumSurvival" /></label>
                    <label class="fb-field" title="Shortest simulated raid. Clamped to 3-60 minutes.">Raid minutes, minimum<input type="number" @bind="p.MinimumRaidMinutes" /></label>
                    <label class="fb-field" title="Longest simulated raid. Clamped to 3-60 minutes.">Raid minutes, maximum<input type="number" @bind="p.MaximumRaidMinutes" /></label>
                </div></section>
                <section class="fb-card"><h2>Personality progression</h2><div class="fb-grid">
                    <label class="fb-field" title="Personality this account turns into after enough raid hours, e.g. Timmy into Casual.">Progress to<select @bind="p.ProgressTo"><option value="">Stay this personality</option>
                        @foreach (var target in people.Where(t => t != p)) { <option value="@target.Id">@target.Id</option> }
                    </select></label>
                    <label class="fb-field" title="Total raid hours before the account switches to the Progress to personality.">Progress after account raid hours<input type="number" @bind="p.TransitionHours" /></label>
                </div></section>
                <section class="fb-card fb-danger-zone"><h2>Remove personality</h2><p class="fb-muted">Removes @p.Id from this draft. Save personalities to apply the removal.</p><button type="button" class="fb-button fb-button-red" @onclick="Remove">Remove @p.Id</button></section>
            }
            <div class="fb-savebar"><span>Starting ranges apply to new accounts. Progression targets affect existing accounts.</span><button type="button" class="fb-button" disabled="@(!Dirty("personalities"))" @onclick="SavePeople">Save personalities</button></div>
        }
        else if (page == "Progression")
        {
            <section class="fb-card">
                <div class="fb-switch-row"><label class="fb-switch" title="When APBS spawns a PMC, reuse an existing career whose level fits APBS's level range, so you meet the same players again."><input type="checkbox" role="switch" @bind="simulation.EnableApbsCareerIntegration" /><span class="fb-switch-track"></span>Select persistent careers within APBS level ranges</label></div>
            </section>
            <section class="fb-card fb-flush"><div class="fb-card-head fb-padded"><div><h2>Raid history priors</h2><p>Bands must increase and end at level 79. These averages are priors, not identical targets for every account.</p></div></div>
                <div class="fb-table-scroll"><table class="fb-table"><thead><tr><th>Maximum level</th><th title="Average length of a raid the account survives.">Survived raid min</th><th title="Average length of a raid that ends in death.">Death raid min</th><th title="For an average-skill account. Skill and personality scale it.">PMC kills / raid</th><th title="For an average-skill account. Skill and personality scale it.">Scav kills / raid</th></tr></thead><tbody>
                    @foreach (var prior in simulation.ProgressionPriors)
                    {
                        var row = simulation.ProgressionPriors.IndexOf(prior) + 1;
                        <tr @key="prior"><td><input aria-label="Maximum level, band @row" type="number" min="1" max="79" @bind="prior.MaximumLevel" /></td>
                            <td><input aria-label="Survived raid minutes, band @row" type="number" min="3" max="60" step="0.5" @bind="prior.SurvivedMinutes" /></td>
                            <td><input aria-label="Death raid minutes, band @row" type="number" min="3" max="60" step="0.5" @bind="prior.DeathMinutes" /></td>
                            <td><input aria-label="PMC kills per raid, band @row" type="number" min="0" max="20" step="0.01" @bind="prior.PmcKills" /></td>
                            <td><input aria-label="Scav kills per raid, band @row" type="number" min="0" max="20" step="0.01" @bind="prior.ScavKills" /></td></tr>
                    }
                </tbody></table></div>
            </section>
            <section class="fb-card"><h2>Raid experience &amp; time</h2><p class="fb-muted">With the defaults an average account needs about 60 raids for level 15, 440 for level 40 and 3,800 for level 79.</p><div class="fb-grid">
                <label class="fb-field" title="XP for a survived raid at level 0. Raid XP decides how many raids an account needed to reach its level.">Survived raid XP, base<input type="number" min="100" max="100000" step="100" @bind="simulation.RaidExperience.SurvivedBase" /></label>
                <label class="fb-field" title="Extra survived raid XP per level.">Survived raid XP, per level<input type="number" min="0" max="10000" step="10" @bind="simulation.RaidExperience.SurvivedPerLevel" /></label>
                <label class="fb-field" title="Extra survived raid XP per level squared, so high levels earn much more per raid.">Survived raid XP, per level squared<input type="number" min="0" max="1000" step="0.5" @bind="simulation.RaidExperience.SurvivedPerLevelSquared" /></label>
                <label class="fb-field" title="Share (0 to 1) of the survived XP a death still earns.">Death XP share<input type="number" min="0" max="1" step="0.05" @bind="simulation.RaidExperience.DeathShare" /></label>
                <label class="fb-field" title="Online time is raid time times a factor between these two, for menus, hideout and flea.">Online time factor, minimum<input type="number" min="1" max="5" step="0.05" @bind="simulation.OnlineTimeMinimum" /></label>
                <label class="fb-field" title="Upper end of the online time factor.">Online time factor, maximum<input type="number" min="1" max="5" step="0.05" @bind="simulation.OnlineTimeMaximum" /></label>
            </div></section>
            <section class="fb-card"><h2>Achievements</h2><p class="fb-muted">Share of level 79, average-skill accounts that own a given achievement. Lower levels own fewer, skill scales it.</p><div class="fb-grid fb-grid-3">
                <label class="fb-field" title="Share (0 to 1) of level 79, average-skill accounts that own a given Common achievement.">Common<input type="number" min="0" max="1" step="0.01" @bind="simulation.Achievements.Common" /></label>
                <label class="fb-field" title="Same for Rare achievements, mostly boss kills.">Rare<input type="number" min="0" max="1" step="0.01" @bind="simulation.Achievements.Rare" /></label>
                <label class="fb-field" title="Same for Legendary achievements, mostly events and Kappa.">Legendary<input type="number" min="0" max="1" step="0.01" @bind="simulation.Achievements.Legendary" /></label>
            </div></section>
            @SimulationSave
        }
        else if (page == "Hideout")
        {
            <section class="fb-card"><h2>Construction</h2><p class="fb-muted">Season cohort observations guide module preferences. Time, wealth, personality and native prerequisites still decide upgrades. Existing construction is never downgraded.</p><div class="fb-grid">
                <label class="fb-field" title="How fast simulated accounts build hideout modules. 1 is normal, 2 is twice as fast.">Construction speed<input type="number" min="0.25" max="4" step="0.05" @bind="simulation.Hideout.ConstructionSpeed" /></label>
                <label class="fb-field" title="How much simulated hideout upgrades cost the account. Higher means slower upgrades.">Material cost multiplier<input type="number" min="0.25" max="4" step="0.05" @bind="simulation.Hideout.MaterialCostMultiplier" /></label>
                <label class="fb-field" title="Scales how likely each hideout module is to be built at all for an account's level.">Built chance multiplier<input type="number" min="0.25" max="2" step="0.05" @bind="simulation.Hideout.BuiltChanceMultiplier" /></label>
                <label class="fb-field" title="Share of accounts that mostly ignore the hideout: few modules, none past level 1, whatever their level.">Hideout neglecters<input type="number" min="0" max="0.5" step="0.01" @bind="simulation.Hideout.NeglectedShare" /></label>
            </div><p class="fb-hint">1 is the default. Edition starting privileges remain. Seasonal events and emergency-wall history are not fabricated.</p></section>
            @SimulationSave
        }
        else if (page == "Gear")
        {
            <section class="fb-card"><h2>Loadouts</h2><p class="fb-muted">APBS builds every loadout. These control which kit it builds and where it is used.</p>
                <div class="fb-switch-row"><label class="fb-switch" title="When a career spawns in raid, it wears the loadout its profile shows, plus fresh APBS loot. Off means APBS rolls a new kit for each spawn."><input type="checkbox" role="switch" @bind="simulation.RetainProfileGearInRaid" /><span class="fb-switch-track"></span>Careers wear their profile loadout in raid</label></div>
                <div class="fb-grid">
                    <label class="fb-field" title="Share (0 to 1) of generated profile loadouts built as night raid kits, which can carry NVGs.">Night kit chance<input type="number" min="0" max="1" step="0.05" @bind="simulation.NightGearChance" /></label>
                </div>
            </section>
            <section class="fb-card"><h2>Showcases</h2><p class="fb-muted">Only accounts that built the weapon rack or trophy stand get a showcase. Favorites stay pinned until an item becomes unavailable.</p>
                <div class="fb-switch-row"><label class="fb-switch" title="Fill weapon racks and trophy stands, only for accounts that have built those hideout modules."><input type="checkbox" role="switch" @bind="simulation.EnableShowcase" /><span class="fb-switch-track"></span>Hideout-gated showcases</label></div>
                <div class="fb-grid">
                    <label class="fb-field" title="Fewest APBS gear tiers above the account's own that rack guns are built at. Capped at APBS's top tier.">Rack gun tier boost, minimum<input type="number" min="0" max="6" @bind="simulation.RackTierBoostMinimum" /></label>
                    <label class="fb-field" title="Most APBS gear tiers above the account's own that rack guns are built at. Each rack loadout rolls in this range.">Rack gun tier boost, maximum<input type="number" min="0" max="6" @bind="simulation.RackTierBoostMaximum" /></label>
                </div>
            </section>
            @SimulationSave
        }
        else if (page == "Notable")
        {
            <section class="fb-card"><h2>Chads and streamers</h2><p class="fb-muted">Accounts with "chad" in the name or a TTV, YT or TV tag are better players and always wear gear above their level's tier, in raid and on their profile.</p>
                <div class="fb-switch-row"><label class="fb-switch" title="Give chad and streamer names better stats and gear."><input type="checkbox" role="switch" @bind="simulation.NotableNames.Enabled" /><span class="fb-switch-track"></span>Boost chads and streamers</label></div>
                <div class="fb-grid fb-grid-3">
                    <label class="fb-field" title="How far their hidden skill roll moves towards the best player. 0.3 closes 30% of the gap, which raises survival, kills and K/D.">Skill bonus<input type="number" min="0" max="1" step="0.05" @bind="simulation.NotableNames.SkillBonus" /></label>
                    <label class="fb-field" title="Fewest APBS gear tiers they skip ahead of their level.">Gear tier boost, minimum<input type="number" min="0" max="6" @bind="simulation.NotableNames.TierBoostMinimum" /></label>
                    <label class="fb-field" title="Most APBS gear tiers they skip ahead of their level. Each account rolls once in this range and keeps it.">Gear tier boost, maximum<input type="number" min="0" max="6" @bind="simulation.NotableNames.TierBoostMaximum" /></label>
                </div>
            </section>
            @SimulationSave
        }
        else if (page == "Prestige")
        {
            <section class="fb-card"><h2>Prestige</h2><p class="fb-muted">Prestige follows the installed requirements and fictional quest histories. Lifetime history and account registration persist.</p>
                <div class="fb-switch-row"><label class="fb-switch" title="Let simulated accounts prestige when they meet the installed prestige requirements."><input type="checkbox" role="switch" @bind="simulation.EnablePrestige" /><span class="fb-switch-track"></span>Prestige progression</label></div>
                <div class="fb-grid fb-grid-3">
                    <label class="fb-field" title="Raid hours an account needs since its last prestige before it can prestige again.">Minimum raid hours per cycle<input type="number" min="10" max="10000" @bind="simulation.MinimumPrestigeCycleHours" /></label>
                    <label class="fb-field" title="Share of new accounts (not Timmies) that start with at least one prestige behind them, at any current level.">Starting prestige share<input type="number" min="0" max="1" step="0.01" @bind="simulation.InitialPrestige.Share" /></label>
                    <label class="fb-field" title="Chance of each further starting prestige. 0.45 means about 45% of prestiged accounts have 2 or more, and 20% have 3 or more.">Further prestige chance<input type="number" min="0" max="0.95" step="0.05" @bind="simulation.InitialPrestige.Repeat" /></label>
                </div>
            </section>
            @SimulationSave
        }
        else if (page == "Stories")
        {
            <section class="fb-card"><h2>Post-raid stories</h2><p class="fb-muted">A PMC that killed you can later die or regear. Outcomes are mutually exclusive, delayed, and never rewrite the killer's historical equipment.</p>
                <div class="fb-switch-row"><label class="fb-switch" title="After a PMC kills you, it may later die or regear, so its profile changes between raids."><input type="checkbox" role="switch" @bind="simulation.EnablePostRaidStories" /><span class="fb-switch-track"></span>Enable post-raid stories</label></div>
                <div class="fb-grid">
                    <label class="fb-field" title="Chance (0 to 1) that a PMC who killed you dies later.">Later death chance<input type="number" min="0" max="1" step="0.01" @bind="simulation.PostRaidDeathChance" /></label>
                    <label class="fb-field" title="Chance (0 to 1) that a PMC who killed you swaps to new gear later.">Survivor regear chance<input type="number" min="0" max="1" step="0.01" @bind="simulation.PostRaidRegearChance" /></label>
                    <label class="fb-field" title="Earliest time after your death that a story outcome can happen.">Delay, minimum seconds<input type="number" min="30" max="86400" @bind="simulation.StoryMinimumDelaySeconds" /></label>
                    <label class="fb-field" title="Latest time after your death that a story outcome can happen.">Delay, maximum seconds<input type="number" min="30" max="86400" @bind="simulation.StoryMaximumDelaySeconds" /></label>
                    <label class="fb-field" title="How long a story outcome stays visible before the account carries on normally.">Outcome visibility, seconds<input type="number" min="60" max="86400" @bind="simulation.StoryVisibilitySeconds" /></label>
                </div><p class="fb-hint">Death and regear chances together cannot exceed 1. Otherwise the killer keeps its kit.</p>
            </section>
            @SimulationSave
        }
        else
        {
            <section class="fb-card"><h2>Friendships</h2>
                <div class="fb-switch-row"><label class="fb-switch" title="Allow sending friend requests to simulated accounts."><input type="checkbox" role="switch" @bind="config.EnableFriendRequests" /><span class="fb-switch-track"></span>Bot friend requests</label></div>
                <div class="fb-grid">
                    <label class="fb-field" title="Chance (0 to 1) that a simulated account accepts your friend request.">Friend acceptance chance<input type="number" min="0" max="1" step="0.01" @bind="config.FriendAcceptanceChance" /></label>
                    <label class="fb-field" title="Accepted friends play and show online this many times as often as other accounts.">Friend activity multiplier<input type="number" min="0" max="5" step="0.1" @bind="config.FriendActivityMultiplier" /></label>
                </div><p class="fb-hint">Disabling new friend requests keeps existing accepted friendships.</p>
            </section>
            <section class="fb-card"><h2>Activity</h2><div class="fb-grid fb-grid-3">
                <label class="fb-field" title="Scales how often every account is online. 1 is the default, 2 doubles it.">Online rate multiplier<input type="number" min="0" max="10" step="0.1" @bind="config.OnlineRateMultiplier" /></label>
                <label class="fb-field" title="Minimum server downtime before accounts get simulated progress for the time you were away.">Offline progression threshold, seconds<input type="number" min="60" max="86400" @bind="config.ProgressionThresholdSeconds" /></label>
                <label class="fb-field" title="Cap on how many offline days of progress are simulated at server start.">Maximum offline days<input type="number" min="1" max="365" @bind="config.MaximumOfflineDays" /></label>
            </div></section>
            <div class="fb-savebar"><span>Existing identities and accepted friends remain.</span><button type="button" class="fb-button" disabled="@(!Dirty("settings"))" @onclick="SaveConfig">Save population settings</button></div>
        }
    </main>
</div>

@code {
    private static readonly string[] topPages = ["Dashboard", "Personalities", "Simulation", "Population"];
    private static readonly string[] simulationPages = ["Progression", "Hideout", "Gear", "Notable", "Prestige", "Stories"];
    private EditorSnapshot? snapshot;
    private List<PersonalityTemplate> people = new();
    private SimulationPolicy simulation = new();
    private PbtSettings config = new();
    private readonly Dictionary<string, string> baselines = new();
    private string page = "Dashboard", message = "";
    private int selectedIndex;
    private bool error, confirmReload, dark = true, menuOpen, simulationOpen = true;

    private RenderFragment SimulationSave => @<div class="fb-savebar"><span>Saves every Simulation page at once.</span><button type="button" class="fb-button" disabled="@(!Dirty("simulation"))" @onclick="SavePolicy">Save simulation policy</button></div>;

    private static string Title(string page) => page switch {
        "Gear" => "Gear & showcases", "Notable" => "Chads & streamers", "Stories" => "Post-raid stories", _ => page };
    private static string Heading(string page) => page switch {
        "Dashboard" => "Population dashboard", "Population" => "Population settings", _ => Title(page) };
    private static string Description(string page) => page switch {
        "Dashboard" => "A snapshot of your server's persistent population.",
        "Personalities" => "Starting ranges and progression targets. Edits affect future simulation without rerolling existing accounts.",
        "Progression" => "Level cohorts guide varied account histories. Native requirements remain in force.",
        "Hideout" => "How simulated accounts build and upgrade their hideout.",
        "Gear" => "Profile loadouts, night kits and weapon racks.",
        "Notable" => "Better stats and gear for chad and streamer names.",
        "Prestige" => "When simulated accounts prestige, and how many start prestiged.",
        "Stories" => "What happens to a PMC after it kills you.",
        _ => "Friendships and activity between server sessions." };
    private static string? Section(string page) => page switch {
        "Personalities" => "personalities", "Population" => "settings", "Dashboard" => null, _ => "simulation" };
    private static string Percent(int part, int whole) => (part * 100.0 / whole).ToString("0.0") + "%";
    private static RenderFragment Icon(string name) => name switch {
        "Dashboard" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v7h7A7 7 0 1 1 10 3Z" /><path d="M13 2.5A5 5 0 0 1 17.5 7H13Z" /></svg>,
        "Personalities" or "Users" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="7.5" cy="7" r="3" /><path d="M2 17a5.5 5.5 0 0 1 11 0M13 4.2a3 3 0 0 1 0 5.6M15 12a5.5 5.5 0 0 1 3 5" /></svg>,
        "Simulation" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="2.5" /><path d="M10 2v3M10 15v3M2 10h3M15 10h3M4.3 4.3l2.1 2.1M13.6 13.6l2.1 2.1M4.3 15.7l2.1-2.1M13.6 6.4l2.1-2.1" /></svg>,
        "Population" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M2.5 10h15M10 2.5c2.2 2.2 2.2 12.8 0 15M10 2.5c-2.2 2.2-2.2 12.8 0 15" /></svg>,
        "GitHub" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 17c-4 1.2-4-2-5.5-2.5M13 18.5v-2.8a2.4 2.4 0 0 0-.7-1.9c2.3-.3 4.7-1.1 4.7-5.1a4 4 0 0 0-1.1-2.7 3.7 3.7 0 0 0-.1-2.7s-.9-.3-2.9 1.1a10 10 0 0 0-5.2 0C5.7 3 4.8 3.3 4.8 3.3a3.7 3.7 0 0 0-.1 2.7A4 4 0 0 0 3.6 8.7c0 4 2.4 4.8 4.7 5.1a2.4 2.4 0 0 0-.7 1.8v2.9" /></svg>,
        "Reload" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.5 10A6.5 6.5 0 1 1 14.6 5.4M16.5 3v3.5H13" /></svg>,
        "Home" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.5 10 3l7 6.5M5 8v8.5h4V12h2v4.5h4V8" /></svg>,
        "Clock" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="M10 6v4l2.5 2.5" /></svg>,
        "Plus" => @<svg class="fb-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>,
        _ => @<svg class="fb-icon fb-icon-sm" viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg> };

    private void Go(string next)
    {
        page = next;
        menuOpen = false;
        if (simulationPages.Contains(next)) simulationOpen = true;
    }
    private void RequestReload()
    {
        menuOpen = false;
        if (new[] { "personalities", "simulation", "settings" }.Any(Dirty)) confirmReload = true;
        else Reload();
    }
    private PersonalityTemplate? Current => selectedIndex >= 0 && selectedIndex < people.Count ? people[selectedIndex] : people.FirstOrDefault();
    private static PopulationStore Store => PopulationStore.Active ?? throw new InvalidOperationException("PBT is not ready.");
    protected override void OnInitialized() => Reload();
    private string Contents(string section) => section switch {
        "personalities" => JsonSerializer.Serialize(people), "simulation" => JsonSerializer.Serialize(simulation), _ => JsonSerializer.Serialize(config) };
    private bool Dirty(string section) => baselines.TryGetValue(section, out var baseline) && baseline != Contents(section);
    private bool PageDirty(string page) => Section(page) is { } section && Dirty(section);
    private void Reload()
    {
        try
        {
            var saved = Store.GetEditorSnapshot();
            var nextPeople = JsonSerializer.Deserialize<List<PersonalityTemplate>>(saved.PersonalitiesJson)!;
            var nextPolicy = JsonSerializer.Deserialize<SimulationPolicy>(saved.PolicyJson)!;
            var nextConfig = JsonSerializer.Deserialize<PbtSettings>(saved.SettingsJson)!;
            snapshot = saved; people = nextPeople; simulation = nextPolicy; config = nextConfig;
            foreach (string section in new[] { "personalities", "simulation", "settings" }) baselines[section] = Contents(section);
            selectedIndex = 0; confirmReload = false; error = false; message = "";
        }
        catch (Exception ex) { error = true; message = ex.Message; }
    }
    private void RefreshStatus()
    {
        try
        {
            var status = Store.GetEditorSnapshot();
            snapshot = snapshot! with { Careers = status.Careers, Online = status.Online, PendingStories = status.PendingStories,
                Prestiged = status.Prestiged, GenerationMode = status.GenerationMode, ApbsMatched = status.ApbsMatched, ApbsFallback = status.ApbsFallback,
                Insights = status.Insights };
            error = false; message = "Status refreshed. Unsaved edits are retained.";
        }
        catch (Exception ex) { error = true; message = ex.Message; }
    }
    private void Add()
    {
        int number = 1; while (people.Any(p => p.Id == "Custom" + number)) number++;
        people.Add(new PersonalityTemplate { Id = "Custom" + number }); selectedIndex = people.Count - 1;
    }
    private void Remove() { if (Current is { } item) people.Remove(item); selectedIndex = 0; }
    private void SavePeople()
    {
        foreach (var item in people) if (string.IsNullOrWhiteSpace(item.ProgressTo)) item.ProgressTo = null;
        Save("personalities", snapshot!.PersonalitiesRevision);
    }
    private void SavePolicy() => Save("simulation", snapshot!.PolicyRevision);
    private void SaveConfig() => Save("settings", snapshot!.SettingsRevision);
    private void Save(string section, string revision)
    {
        try
        {
            string value = Contents(section);
            Store.SaveEditorSection(section, value, revision);
            var saved = Store.GetEditorSnapshot();
            snapshot = section switch {
                "personalities" => snapshot! with { PersonalitiesRevision = saved.PersonalitiesRevision },
                "simulation" => snapshot! with { PolicyRevision = saved.PolicyRevision },
                _ => snapshot! with { SettingsRevision = saved.SettingsRevision } };
            baselines[section] = value; error = false;
            message = "Saved and applied. Other unsaved sections are unchanged.";
        }
        catch (Exception ex) { error = true; message = ex.Message; }
    }
}
