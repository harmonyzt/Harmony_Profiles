                    <h2>Personalities</h2>
                    <p>@(perType
                           ? "Weights are relative, so they need not add up to anything. Chances are 0 to 1."
                           : "Weights are editable here; the chances come from the shared cards below. Always means the personality always has it, a dash that it never can.")</p>
                </div>
            </div>
            <div class="fb-table-scroll fb-matrix-wrap">
                <table class="fb-table fb-matrix">
                    <thead>
                    <tr>
                        <th></th>
                        @foreach (var type in CheaterRules.Types)
                        {
                            <th>@type@(Tip(PersonalityTip(type)))</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    <tr class="fb-matrix-head">
                        <td>Weight</td>
                        @foreach (var type in CheaterRules.Types)
                        {
                            var t = type;
                            <td>
                                <input type="number" min="0" max="@(perType ? 100 : 1)" step="0.05"
                                       value="@Invariant(effective[t].Weight)" @onchange="e => SetWeight(t, e.Value)"/>
                                <span class="fb-muted">@((Math.Max(0, effective[t].Weight) / weightTotal).ToString("P0"))</span>
                            </td>
                        }
                    </tr>
                    @foreach (var cheat in CheaterRules.Cheats)
                    {
                        var c = cheat;
                        <tr>
                            <td>@CheaterRules.CheatLabels[c]</td>
                            @foreach (var type in CheaterRules.Types)
                            {
                                var t = type;
                                <td>
                                    @if (perType)
                                    {
                                        <input type="number" min="0" max="1" step="0.05"
                                               value="@Invariant(CheaterRules.Chance(play.Personalities.Get(t), c))"
                                               @onchange="e => SetChance(t, c, e.Value)"/>
                                    }
                                    else
                                    {
                                        @switch (CheaterRules.Allowed(t, c))
                                        {
                                            case CheaterRules.Access.Always:
                                                <span class="fb-badge fb-badge-green">Always</span>
                                                break;
                                            case CheaterRules.Access.May:
                                                <span>@CheaterRules.SharedChance(play, c).ToString("P0")</span>
                                                break;
                                            default:
                                                <span class="fb-muted">-</span>
                                                break;
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                    @foreach (var (key, label) in new[] { ("AimAccuracy", "Aim accuracy"), ("ReactionTime", "Reaction time"), ("SpeedMultiplier", "Speedhack multiplier") })
                    {
                        var k = key;
                        <tr class="@(k == "AimAccuracy" ? "fb-matrix-head" : "")">
                            <td>@label</td>
                            @foreach (var type in CheaterRules.Types)
                            {
                                var t = type;
                                var p = effective[t];
                                double v = k switch { "AimAccuracy" => p.AimAccuracy, "ReactionTime" => p.ReactionTime, _ => p.SpeedMultiplier };
                                <td>
                                    @if (perType)
                                    {
                                        <input type="number" step="0.05"
                                               min="@(k == "AimAccuracy" ? 0 : k == "ReactionTime" ? 0.5 : 1)"
                                               max="@(k == "AimAccuracy" ? 1 : k == "ReactionTime" ? 3 : 6)"
                                               value="@Invariant(v)" @onchange="e => SetTuning(t, k, e.Value)"/>
                                    }
                                    else
                                    {
                                        <span>@v.ToString("0.##")</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="fb-card">
