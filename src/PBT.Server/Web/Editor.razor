        _ => @<svg class="fb-icon fb-icon-sm" viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg> };

    private CancellationTokenSource? noticeTimer;
    private void Notify(bool isError, string text)
    {
        ClearNotice();
        error = isError; message = text;
        _ = Dismiss((noticeTimer = new()).Token, isError ? 10000 : 5000);
    }
    private async Task Dismiss(CancellationToken token, int milliseconds)
    {
        try
        {
            await Task.Delay(milliseconds, token);
            // A newer notice may have replaced this one while the callback was queued.
            await InvokeAsync(() => { if (token.IsCancellationRequested) return; message = ""; StateHasChanged(); });
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException) { }
    }
    private void ClearNotice()
    {
        noticeTimer?.Cancel(); noticeTimer?.Dispose(); noticeTimer = null;
        message = "";
    }
    private void Go(string next)
    {
        ClearNotice();
        page = next;
        slideHeld = slideHover = false;
        confirmPreset = confirmDelete = "";
        if (next is "Overview" or "Players") LoadWorld();
        if (next == "Presets") LoadPresets();
        menuOpen = false;
        if (simulationPages.Contains(next)) simulationOpen = true;
    }
    private void RequestReload()
    {
        menuOpen = false;
        if (new[] { "personalities", "simulation", "settings" }.Any(Dirty)) confirmReload = true;
        else Reload();
    }
    private PersonalityTemplate? Current => selectedIndex >= 0 && selectedIndex < people.Count ? people[selectedIndex] : people.FirstOrDefault();
    private static PopulationStore Store => PopulationStore.Active ?? throw new InvalidOperationException("PBT is not ready.");
    protected override void OnInitialized()
    {
        Reload();
        LoadWorld();
        try { presets = Store.GetPresets(); } catch { }
    }
    protected override void OnAfterRender(bool first)
    {
        if (first) live = new System.Threading.Timer(_ => _ = InvokeAsync(Tick), null, 3000, 3000);
    }
    public void Dispose() { live?.Dispose(); noticeTimer?.Cancel(); noticeTimer?.Dispose(); }

    private void LoadWorld()
    {
        try
        {
            world = Store.GetWorld(25);
            if (page == "Players") players = Store.GetPlayers();
            if (world.Maps.Count > 0) slide %= world.Maps.Count;
        }
        catch { }
    }
    private async Task Tick()
    {
        if (animating || snapshot is null) return;
        if (page is "Overview" or "Players") LoadWorld();
        else if (page == "Player") LoadProfile();
        else if (page == "Dashboard") UpdateStatus();
        else return;
        // A picked slide stays put until the user leaves the page.
        if (page == "Overview" && !slideHeld && !slideHover && ++ticks % 2 == 0 && world?.Maps.Count > 1) slide = (slide + 1) % world.Maps.Count;
        StateHasChanged();
        // Ease shown numbers toward the values the last render asked for.
        animating = true;
        try
        {
            for (int frame = 0; frame < 12 && shownNumbers.Any(p => Math.Abs(p.Value - targetNumbers[p.Key]) > .5); frame++)
            {
                await Task.Delay(40);
                foreach (var key in shownNumbers.Keys.ToList())
                    shownNumbers[key] = frame == 11 ? targetNumbers[key] : shownNumbers[key] + (targetNumbers[key] - shownNumbers[key]) * .3;
                StateHasChanged();
            }
        }
        finally { animating = false; }
    }
    private string Num(string key, int value)
    {
        targetNumbers[key] = value;
        if (!shownNumbers.TryGetValue(key, out double shown)) shownNumbers[key] = shown = value;
        return Math.Round(shown).ToString("N0");
    }
    private IEnumerable<WorldPlayerRow> FilteredPlayers()
    {
        IEnumerable<WorldPlayerRow> rows = players;
        if (!string.IsNullOrWhiteSpace(playerSearch)) rows = rows.Where(p => p.Name.Contains(playerSearch.Trim(), StringComparison.OrdinalIgnoreCase));
        if (playerFilter == "Online") rows = rows.Where(p => p.State is not ("Offline" or "Died"));
        else if (playerFilter == "Squad") rows = rows.Where(p => p.Squad.Length > 0);
        else if (playerFilter.Length > 0) rows = rows.Where(p => p.State == playerFilter);
        Func<WorldPlayerRow, object> key = playerSort switch {
            "Name" => p => p.Name, "Level" => p => p.Level, "Prestige" => p => p.Prestige, "Raids" => p => p.Raids, "K/D" => p => p.KillDeath,
            _ => p => StateOrder(p.State) };
        var sorted = sortDescending ? rows.OrderByDescending(key) : rows.OrderBy(key);
        return sorted.ThenByDescending(p => p.Level).ThenBy(p => p.Name);
    }
    // Same color on every member's row, so teams stand out in the list.
    private static int TeamHue(WorldPlayerRow row) => Hue(string.Join("|", row.Team.Append(row.Name).Order(StringComparer.Ordinal)));
    private static string StateLabel(string state) => state switch {
        "Raid" => "In raid", "Queue" => "Queueing", "Transit" => "Transit", "Menu" => "Online", "Afk" => "AFK", "Died" => "Dead", _ => "Offline" };
    private static int StateOrder(string state) => state switch { "Raid" => 0, "Queue" => 1, "Transit" => 2, "Menu" => 3, "Afk" => 4, "Died" => 5, _ => 6 };
    private static int Hue(string id) => (int)((uint)id.Aggregate(17, (h, c) => h * 31 + c) % 360);
    private static int Bars(double share) => share >= .15 ? 4 : share >= .09 ? 3 : share >= .04 ? 2 : share > 0 ? 1 : 0;
    private static string Clock(int seconds) => $"{seconds / 60}:{seconds % 60:D2}";
    private static string Duration(long seconds) => seconds < 60 ? $"{seconds}s" : seconds < 3600 ? $"{seconds / 60}m" : seconds < 86400 ? $"{seconds / 3600}h {seconds % 3600 / 60}m" : $"{seconds / 86400}d";
    private static string Ago(long utc)
    {
        long seconds = Math.Max(0, DateTimeOffset.UtcNow.ToUnixTimeSeconds() - utc);
        return seconds < 10 ? "now" : Duration(seconds) + " ago";
    }
    private static RenderFragment Sparkline(int[] points)
    {
        if (points.Length < 2) return @<span class="fb-muted">-</span>;
        int top = Math.Max(1, points.Max());
        string line = string.Join(" ", points.Select((v, i) => string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{i * 100.0 / (points.Length - 1):0.#},{22 - v * 20.0 / top:0.#}")));
        return @<svg class="fb-spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true"><polyline points="@line" /></svg>;
    }
    private string Contents(string section) => section switch {
        "personalities" => JsonSerializer.Serialize(people), "simulation" => JsonSerializer.Serialize(simulation), _ => JsonSerializer.Serialize(config) };
    private readonly Dictionary<string, bool> dirtyCache = new();
    // Cleared at the top of every render, so each section is serialized once per render.
    private bool Dirty(string section)
    {
        if (dirtyCache.TryGetValue(section, out bool dirty)) return dirty;
        return dirtyCache[section] = baselines.TryGetValue(section, out var baseline) && baseline != Contents(section);
    }
    private bool PageDirty(string page) => Section(page) is { } section && Dirty(section);
    private void Reload()
    {
        try
        {
            var saved = Store.GetEditorSnapshot();
            var nextPeople = JsonSerializer.Deserialize<List<PersonalityTemplate>>(saved.PersonalitiesJson)!;
            var nextPolicy = JsonSerializer.Deserialize<SimulationPolicy>(saved.PolicyJson)!;
            var nextConfig = JsonSerializer.Deserialize<PbtSettings>(saved.SettingsJson)!;
            snapshot = saved; people = nextPeople; simulation = nextPolicy; config = nextConfig;
            foreach (string section in new[] { "personalities", "simulation", "settings" }) baselines[section] = Contents(section);
            selectedIndex = 0; confirmReload = false; error = false; ClearNotice(); dirtyCache.Clear();
        }
        catch (Exception ex) { Notify(true, ex.Message); }
    }
    private void RefreshStatus()
    {
        try
        {
            UpdateStatus(true);
            Notify(false, "Status refreshed. Unsaved edits are retained.");
        }
        catch (Exception ex) { Notify(true, ex.Message); }
    }
    private void UpdateStatus(bool rethrow = false)
    {
        try
        {
            var status = Store.GetEditorSnapshot();
            snapshot = snapshot! with { Careers = status.Careers, Online = status.Online, PendingStories = status.PendingStories,
                Prestiged = status.Prestiged, GenerationMode = status.GenerationMode, ApbsMatched = status.ApbsMatched, ApbsFallback = status.ApbsFallback,
                Insights = status.Insights };
        }
        catch when (!rethrow) { }
    }
    private string presetFolder = "";
    private void LoadPresets()
    {
        try { presets = Store.GetPresets(); presetFolder = Store.PresetFolderPath; }
        catch (Exception ex) { Notify(true, ex.Message); }
    }
    private void OpenPresetFolder()
    {
        try
        {
            Store.OpenPresetFolder();
            Notify(false, "Opened " + presetFolder + " on the server's PC. Press Refresh after adding presets.");
        }
        catch (Exception ex) { Notify(true, $"Could not open the folder ({ex.Message}). It is at {presetFolder}"); }
    }
    private void LoadPreset(string name, bool discard)
    {
        if (!discard && new[] { "personalities", "simulation", "settings" }.Any(Dirty)) { confirmPreset = name; return; }
        try
        {
            Store.ApplyPreset(name);
            Reload();
            LoadPresets();
            Notify(false, $"Loaded and applied {name}.");
        }
        catch (Exception ex) { Notify(true, ex.Message); }
        confirmPreset = "";
    }
    private void SavePreset(string name, bool overwrite)
    {
        try
        {
            foreach (var item in people) if (string.IsNullOrWhiteSpace(item.ProgressTo)) item.ProgressTo = null;
            Store.SavePreset(name, overwrite, Contents("personalities"), Contents("simulation"), Contents("settings"),
                [snapshot!.PersonalitiesRevision, snapshot.PolicyRevision, snapshot.SettingsRevision]);
            Reload();
            LoadPresets();
            presetName = "";
            Notify(false, $"Saved, applied and selected {name.Trim()}.");
        }
        catch (Exception ex) { Notify(true, ex.Message); }
    }
    private void DeletePreset(string name)
    {
        try
        {
            Store.DeletePreset(name);
            LoadPresets();
            Notify(false, $"Deleted {name}.");
        }
        catch (Exception ex) { Notify(true, ex.Message); }
        confirmDelete = "";
    }
    private void Add()
    {
        int number = 1; while (people.Any(p => p.Id == "Custom" + number)) number++;
        people.Add(new PersonalityTemplate { Id = "Custom" + number }); selectedIndex = people.Count - 1;
    }
    private void Remove() { if (Current is { } item) people.Remove(item); selectedIndex = 0; }
    private void SavePeople()
    {
        foreach (var item in people) if (string.IsNullOrWhiteSpace(item.ProgressTo)) item.ProgressTo = null;
        Save("personalities", snapshot!.PersonalitiesRevision);
    }
    private void SavePolicy() => Save("simulation", snapshot!.PolicyRevision);
    private void SaveConfig() => Save("settings", snapshot!.SettingsRevision);
    private void Save(string section, string revision)
    {
        try
        {
            string value = Contents(section);
            Store.SaveEditorSection(section, value, revision);
            baselines[section] = value; dirtyCache.Clear();
            EditorSnapshot saved;
            try { saved = Store.GetEditorSnapshot(); }
            catch { Notify(true, "Saved, but the new revision could not be read. Use Reload saved settings before saving again."); return; }
            snapshot = section switch {
                "personalities" => snapshot! with { PersonalitiesRevision = saved.PersonalitiesRevision },
                "simulation" => snapshot! with { PolicyRevision = saved.PolicyRevision },
                _ => snapshot! with { SettingsRevision = saved.SettingsRevision } };
            try { presets = Store.GetPresets(); } catch { }
            Notify(false, "Saved and applied. Other unsaved sections are unchanged.");
        }
        catch (Exception ex) { Notify(true, ex.Message); }
    }
}
